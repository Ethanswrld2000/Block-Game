// Every voiced line (game::lines), from the doc "Legacy: Voice Script" plus the cast's dialogue trees.
// id: what dialogue.ron and cutscenes.ron name; a recording at assets/voice/<id>.ogg plays if it exists,
// otherwise the speaker's babble (npc::voice). The subtitle always shows. speaker: an NPC's dialogue key
// (npcs.ron) or a story name (nayphen = you). trigger: barks only, repeatable lines picked at random.
// direction: notes for the actor and the cutscene. {key} is filled in by services (Orrin's weather...).
[
    // C01 The crash (start of a new world)
    (id: "C01_01", speaker: "nayphen", text: "Nearly there. The island's just past this haze.", direction: "At the helm, flying in"),
    (id: "C01_02", speaker: "nayphen", text: "Court colours... They found me.", direction: "A court warship closes in"),
    (id: "C01_03", speaker: "nayphen", text: "No. No, no, no!", direction: "Hit; the envelope burns"),
    (id: "C01_04", speaker: "nayphen", text: "...Still breathing. That's something.", direction: "Waking on her back"),
    (id: "C01_05", speaker: "bram", text: "Easy now. You're alive. I watched that ship come down and didn't think anyone walked away from it.", direction: "Walks up, relieved"),
    (id: "C01_06", speaker: "nayphen", text: "They shot me down. A court ship."),
    (id: "C01_07", speaker: "bram", text: "Then they want you gone, whoever you are. I'm Bram. Glad you made it."),
    (id: "C01_08", speaker: "bram", text: "But listen. Night comes fast on this island, and the weather here can kill you. Cold, storms, all of it.", direction: "Glances at the sky"),
    (id: "C01_09", speaker: "bram", text: "Here. Take this urn. Everything you build grows from it.", direction: "Hands over the Ancestral Urn"),
    (id: "C01_09b", speaker: "bram", text: "First, sticks and stones. I've marked the nearest ones.", direction: "Points; waypoints appear"),
    (id: "C01_10", speaker: "bram", text: "Before that urn goes down it wants a proper home. Walls all round, a floor and a roof over it.", direction: "Planning the base"),
    (id: "C01_11", speaker: "bram", text: "Hang a door in one wall so you can get in and out, and keep a torch burning inside."),
    (id: "C01_12", speaker: "bram", text: "Keep it small, a few blocks each way. Dirt or stone does for walls until you've better. Stand inside when it's done and I'll tell you if it holds."),
    // Day one with Bram (guide.ron steps): he walks over as each step comes up
    (id: "G_camp_01", speaker: "bram", text: "That's enough fiber."),
    (id: "G_camp_02", speaker: "bram", text: "Weave yourself a bedroll, then find a flat spot and press B. The urn goes beside it."),
    (id: "G_fiber_01", speaker: "bram", text: "Good. That's enough to start."),
    (id: "G_fiber_02", speaker: "bram", text: "Now plant fiber. Pull up tall grass and reeds. Get ten."),
    (id: "G_bed_01", speaker: "bram", text: "There. That's your camp."),
    (id: "G_bed_02", speaker: "bram", text: "Put four sticks and four fiber in the urn. It will weave you a mat to work on."),
    (id: "G_sleep_01", speaker: "bram", text: "Good. That fire will keep you through the night."),
    (id: "G_sleep_02", speaker: "bram", text: "When it gets dark, lie down by it and press Z. I'll be by the urn."),
    // C02 Bram arrives (morning of day 2)
    (id: "C02_01", speaker: "bram", text: "That wreck of yours is smoking like a signal fire. Half the sky can see it.", direction: "Walks into camp"),
    (id: "C02_02", speaker: "nayphen", text: "You stayed."),
    (id: "C02_03", speaker: "bram", text: "I did. And I know who you are now, heir. Your face is on every court notice from here to the eastern reach."),
    (id: "C02_04", speaker: "nayphen", text: "Then you know they'll pay for me."),
    (id: "C02_05", speaker: "bram", text: "They'd pay. I'd sooner watch that court fall than take a coin from it.", direction: "Bitter"),
    (id: "C02_06", speaker: "nayphen", text: "Why?"),
    (id: "C02_07", speaker: "bram", text: "Ask me another day. Right now you need fire, food and a roof. In that order."),
    (id: "C02_08", speaker: "bram", text: "There's an old gate east of here. Things come out of it. Things worth having, if you're brave or stupid.", direction: "Points east; Rotting Gate marked"),
    // C03 The Rotting Gate (first visit)
    (id: "C03_01", speaker: "brindlespheimer", text: "Ah. A... visitor.", direction: "Slow, flat, no expression"),
    (id: "C03_02", speaker: "nayphen", text: "Is this the way in?"),
    (id: "C03_03", speaker: "brindlespheimer", text: "It is... a way. In. Yes."),
    (id: "C03_04", speaker: "brindlespheimer", text: "Before you go... I will take you... out of your body.", direction: "Raises a hand"),
    (id: "C03_05", speaker: "brindlespheimer", text: "...Done.", direction: "Long pause. Nothing happens"),
    (id: "C03_06", speaker: "nayphen", text: "I don't feel any different."),
    (id: "C03_07", speaker: "brindlespheimer", text: "If you...", direction: "Stops. Stares. Never finishes"),
    (id: "C03_08", speaker: "brindlespheimer", text: "The door is... that way."),
    (id: "C03_09", speaker: "brindlespheimer", text: "Wait. How it works. I will say it plainly, once.", direction: "Snaps back into focus"),
    (id: "C03_10", speaker: "brindlespheimer", text: "Walk into a room with foes and the doors slam shut. Beat them all and the doors open. There is always a way on."),
    (id: "C03_11", speaker: "brindlespheimer", text: "Every floor has a boss. It drops a key. The key opens the stair down, in the boss's own room."),
    (id: "C03_12", speaker: "brindlespheimer", text: "If your spirit falls, you wake here, and whatever you found down there is lost. Ask me if you forget."),
    // C04 Sporrow (first visit)
    (id: "C04_01", speaker: "sporrow_elder", text: "Stop there. No fire past the stones.", direction: "Mushroom folk gather"),
    (id: "C04_02", speaker: "nayphen", text: "I'm not here to burn anything.", direction: "Lowers torch"),
    (id: "C04_03", speaker: "sporrow_elder", text: "They all say that. The one past the ridge said it too."),
    (id: "C04_04", speaker: "nayphen", text: "Who?"),
    (id: "C04_05", speaker: "sporrow_elder", text: "Gilm. We don't speak of him. Go, and take your torches with you.", direction: "Gilm's hut marked"),
    // C05 Gilm
    (id: "C05_01", speaker: "gilm", text: "If they sent you to tell me to put the forge out, they can come say it themselves.", direction: "Hammering, doesn't look up"),
    (id: "C05_02", speaker: "nayphen", text: "Nobody sent me. I need tools."),
    (id: "C05_03", speaker: "gilm", text: "...Tools.", direction: "Looks her up and down"),
    (id: "C05_04", speaker: "gilm", text: "That pick you're holding is a disgrace."),
    (id: "C05_05", speaker: "nayphen", text: "Then come make me a better one. I've got a camp, and nobody there is afraid of fire."),
    (id: "C05_06", speaker: "gilm", text: "...Fine. But I work how I work.", direction: "Starts following"),
    // C06 First urn (depth 1 boss beaten)
    (id: "C06_01", speaker: "nayphen", text: "An urn. Down here?", direction: "Boss falls, urn revealed"),
    (id: "C06_02", speaker: "nayphen", text: "Bram will know what to do with this."),
    (id: "C06_03", speaker: "bram", text: "Carpentry. Walls, doors, a proper roof. Now we're a camp, not a crash site.", direction: "Back at camp"),
    // C07 Wren's first landing (day after the carpentry bench stands)
    (id: "C07_01", speaker: "wren", text: "Well! Someone's moved in. Last time I flew over, this was a swamp and a smoking hole.", direction: "Small flying machine lands"),
    (id: "C07_02", speaker: "nayphen", text: "Who are you?"),
    (id: "C07_03", speaker: "wren", text: "Wren. I trade. You've got things, I've got things. Every other day, if the wind's kind."),
    (id: "C07_04", speaker: "wren", text: "And don't ask where I've been. Bad for business.", direction: "Wink"),
    // C08 Liora (found on depth 2, then at camp)
    (id: "C08_01", speaker: "liora", text: "Took you long enough. I was starting to like the chains.", direction: "Chained in a cell"),
    (id: "C08_02", speaker: "nayphen", text: "Who put you here?"),
    (id: "C08_03", speaker: "liora", text: "Bad luck and worse company. Get me out and I'll tell you over a fire.", direction: "Cut to camp"),
    (id: "C08_04", speaker: "liora", text: "I know your face, heir. I spent years at that court. I paid my way out, the same kind of night you ran."),
    (id: "C08_05", speaker: "nayphen", text: "I'm looking for my aunt."),
    (id: "C08_06", speaker: "liora", text: "Then you're lucky. I knew her.", direction: "Clue 1 added"),
    (id: "C08_07", speaker: "liora", text: "She didn't run blind. She was looking for something."),
    (id: "C08_08", speaker: "liora", text: "There was a rat at court she used to feed. If anyone saw what she was after, it was him.", direction: "Points to Messler"),
    // C09 Messler (depth 3 boss room)
    (id: "C09_01", speaker: "messler", text: "Oh, wonderful. Another one. Come to steal the urn? Take it. It's ugly.", direction: "Sitting on the urn"),
    (id: "C09_02", speaker: "nayphen", text: "You can talk."),
    (id: "C09_03", speaker: "messler", text: "A hundred and thirty years, and that's still the first thing everyone says."),
    (id: "C09_04", speaker: "messler", text: "A court wizard did this to me. Thought a clever rat would be funny. It wasn't, for me."),
    (id: "C09_05", speaker: "nayphen", text: "Come with me. I've got a cooking station."),
    (id: "C09_06", speaker: "messler", text: "Food? ...Fine. But I'm not carrying anything."),
    // C10 Messler's story (first time you feed him)
    (id: "C10_01", speaker: "messler", text: "Your aunt? The tall one with ink on her fingers? Oh, I remember her.", direction: "Eating"),
    (id: "C10_02", speaker: "messler", text: "She fed me. Only one at that court who ever did."),
    (id: "C10_03", speaker: "messler", text: "Every night in the old archive. Maps, star charts, things she shouldn't have had."),
    (id: "C10_04", speaker: "messler", text: "The night she left, she said she was going somewhere the wind can't find her. Mountains. An old tower.", direction: "Clue 2 added"),
    (id: "C10_05", speaker: "nayphen", text: "A tower in the mountains...", direction: "Castle marked; triggers the raid that night"),
    // C11 The raid (night after clue 2)
    (id: "C11_01", speaker: "bram", text: "Ships. Court ships. Everyone up!", direction: "Airships overhead"),
    (id: "C11_02", speaker: "nayphen", text: "They found us."),
    (id: "C11_03", speaker: "liora", text: "They always do."),
    (id: "C11_04", speaker: "gilm", text: "Sporrow! They're going for the village!", direction: "Fire glow over the ridge"),
    (id: "C11_05", speaker: "bram", text: "Hold the camp. I'll draw them off.", direction: "Encounter: court soldiers"),
    // C12 Bram's death (raid encounter cleared)
    (id: "C12_01", speaker: "nayphen", text: "Bram! Bram, stay with me.", direction: "Bram on the ground"),
    (id: "C12_02", speaker: "bram", text: "You asked me why I hate them.", direction: "Weak"),
    (id: "C12_03", speaker: "bram", text: "This. This is why. Every time."),
    (id: "C12_04", speaker: "bram", text: "Don't run from it, heir. Not this time.", direction: "Dies"),
    (id: "C12_05", speaker: "messler", text: "He fed me too, you know. Badly. But he did.", direction: "At the grave, next morning"),
    // C13 Orrin (reaching the castle tower)
    (id: "C13_01", speaker: "orrin", text: "You're late. The clouds said someone would come three days ago.", direction: "Facing the window"),
    (id: "C13_02", speaker: "nayphen", text: "You knew I was coming?"),
    (id: "C13_03", speaker: "orrin", text: "I know when it'll rain. People are harder."),
    (id: "C13_04", speaker: "nayphen", text: "I'm looking for a woman who came here years ago. My aunt."),
    (id: "C13_05", speaker: "orrin", text: "She sat in that chair and watched the sky for a month. Then she left with a map and didn't say goodbye."),
    (id: "C13_06", speaker: "nayphen", text: "Come back with me. There's a place for you, and a better view."),
    (id: "C13_07", speaker: "orrin", text: "...Wind's turning east. Good day for walking. Fine.", direction: "Starts following"),
    // C14 The telescope (first look through it at camp)
    (id: "C14_01", speaker: "orrin", text: "There. Past the cloud line. The island with the broken arch.", direction: "Telescope view"),
    (id: "C14_02", speaker: "nayphen", text: "There's smoke. Someone lives there."),
    (id: "C14_03", speaker: "orrin", text: "Your aunt watched that island every night. I'd wager she's on it now.", direction: "Clue 3 added"),
    (id: "C14_04", speaker: "nayphen", text: "Then I need a ship."),
    // C15 The airship (first airship built)
    (id: "C15_01", speaker: "wren", text: "That's not a ship, that's a crate with ambitions.", direction: "Walks around it"),
    (id: "C15_02", speaker: "nayphen", text: "Will it fly?"),
    (id: "C15_03", speaker: "wren", text: "It'll fly. Whether it lands is up to you."),
    (id: "C15_04", speaker: "liora", text: "Go. Find her."),
    // C16 The aunt (landing on her island)
    (id: "C16_01", speaker: "aunt", text: "...Nayphen?"),
    (id: "C16_02", speaker: "nayphen", text: "You ran."),
    (id: "C16_03", speaker: "aunt", text: "I did."),
    (id: "C16_04", speaker: "nayphen", text: "So did I. I thought finding you would be the way out."),
    (id: "C16_05", speaker: "aunt", text: "There is no way out. Twenty years running, and the court is still in every sky I look at."),
    (id: "C16_06", speaker: "aunt", text: "But I found something. Every big island is held up by magic. Each quadrant has a control matrix, a crystal at its heart."),
    (id: "C16_07", speaker: "aunt", text: "This is the north quadrant's. Here.", direction: "Marks the north matrix on the map"),
    (id: "C16_08", speaker: "nayphen", text: "And the others?"),
    (id: "C16_09", speaker: "aunt", text: "Not yet. Some things are dangerous to know.", direction: "Looks away"),
    (id: "C16_10", speaker: "aunt", text: "The ones who raised these islands were half human, half god. I think they fled something below. Monsters. Storms. I can't prove it."),
    (id: "C16_11", speaker: "aunt", text: "I went to the Fractured Imperium. They laughed. Their magicians and scientists would know, they said."),
    (id: "C16_12", speaker: "nayphen", text: "If the matrix goes down, the court's section falls."),
    (id: "C16_13", speaker: "aunt", text: "Yes."),
    (id: "C16_14", speaker: "nayphen", text: "Then I'm done running."),
    // C17 Spheed (he catches you in the sky)
    (id: "C17_01", speaker: "spheed", text: "Heir Nayphen. By order of the Serpentine Air Faring Court, you will come with me.", direction: "Court airship pulls alongside"),
    (id: "C17_02", speaker: "nayphen", text: "No. Not this time.", direction: "She turns her ship to face his. Encounter: Spheed's ship"),
    (id: "C17_03", speaker: "spheed", text: "I followed you everywhere. The swamp. The village they burned. The grave.", direction: "After the fight; he lowers his weapon"),
    (id: "C17_04", speaker: "spheed", text: "I've burned villages. I've chained people for that court. I can't do it any more."),
    (id: "C17_05", speaker: "spheed", text: "Their air defences answer to my ship. I can pull them off the outpost."),
    (id: "C17_06", speaker: "nayphen", text: "Why would you help me?"),
    (id: "C17_07", speaker: "spheed", text: "Because someone should have stopped me years ago."),
    // C18 The last attack (on camp)
    (id: "C18_01", speaker: "liora", text: "Ships on the horizon. More than last time."),
    (id: "C18_02", speaker: "nayphen", text: "Then we hold. Everyone to the urns."),
    (id: "C18_03", speaker: "gilm", text: "Finally. Something worth forging for."),
    (id: "C18_04", speaker: "messler", text: "If I die, I want it noted I was against this."),
    (id: "C18_05", speaker: "orrin", text: "Wind's with us tonight. Their ships will drift.", direction: "Encounter: court attack"),
    // C19 The outpost
    (id: "C19_01", speaker: "spheed", text: "I'm pulling them off now. You'll have a minute. Maybe two.", direction: "His ship turns toward the defences"),
    (id: "C19_02", speaker: "nayphen", text: "Go.", direction: "The defences chase him; the way in opens"),
    // C20 The crystals (inside the east island)
    (id: "C20_01", speaker: "nayphen", text: "The barrier is fed from here. And there's another one, west.", direction: "Huge crystal"),
    (id: "C20_02", speaker: "cultist", text: "The heir. Kneel, and the court may forgive you."),
    (id: "C20_03", speaker: "nayphen", text: "I've heard that before.", direction: "Encounter: cultists. Repeat at the west island"),
    (id: "C20_04", speaker: "nayphen", text: "The shield's failing.", direction: "After both crystals"),
    // C21 Ending
    (id: "C21_01", speaker: "spheed", text: "Their defences are down. The north matrix is open to anyone brave enough."),
    (id: "C21_02", speaker: "nayphen", text: "Then that's where we go next."),
    (id: "C21_03", speaker: "nayphen", text: "I ran to get away from all of this. Every road I took brought me back.", direction: "Looking toward the court"),
    (id: "C21_04", speaker: "nayphen", text: "So I'll stop running. And they'll be the ones who fall.", direction: "Fade out. Sequel hook"),
    // Barks
    (id: "BARK_BRAM_01", speaker: "bram", trigger: "idle_camp", text: "Fire first. Then food. Then worry about the rest."),
    (id: "BARK_BRAM_02", speaker: "bram", trigger: "dusk", text: "Strange things come out at night. Keep a torch close."),
    (id: "BARK_BRAM_03", speaker: "bram", trigger: "talk_no_goal", text: "That gate won't clear itself."),
    (id: "BARK_BRAM_04", speaker: "bram", trigger: "talk", text: "You ran from them. Good. Now let's make sure you stay gone."),
    (id: "BARK_BRAM_05", speaker: "bram", trigger: "storm_coming", text: "Sky's turning. Get under a roof, quick."),
    (id: "BARK_BRAM_06", speaker: "bram", trigger: "storm_coming", text: "Feel that wind? Something nasty's rolling in."),
    (id: "BARK_GILM_01", speaker: "gilm", trigger: "talk", text: "Bring me ore. I'll make it worth carrying."),
    (id: "BARK_GILM_02", speaker: "gilm", trigger: "worn_tool", text: "That pick is a disgrace. Give it here."),
    (id: "BARK_GILM_03", speaker: "gilm", trigger: "tool_made", text: "Done. Don't break it."),
    (id: "BARK_GILM_04", speaker: "gilm", trigger: "idle_forge", text: "They called it dangerous. I call it a forge."),
    (id: "BARK_WREN_01", speaker: "wren", trigger: "lands", text: "Back again. Let's see what you've got worth my time."),
    (id: "BARK_WREN_02", speaker: "wren", trigger: "haggling", text: "That? I'll give you half. Fine, two thirds."),
    (id: "BARK_WREN_03", speaker: "wren", trigger: "trade_done", text: "Pleasure. Mostly mine."),
    (id: "BARK_WREN_04", speaker: "wren", trigger: "leaving", text: "Off tomorrow. Don't wait up."),
    (id: "BARK_LIORA_01", speaker: "liora", trigger: "talk", text: "Ask the right question and I might answer it."),
    (id: "BARK_LIORA_02", speaker: "liora", trigger: "making_clothes", text: "Hold still. Court tailors took weeks. I take minutes."),
    (id: "BARK_LIORA_03", speaker: "liora", trigger: "making_armor", text: "That armor fits like a lie. Let me fix it."),
    (id: "BARK_LIORA_04", speaker: "liora", trigger: "talk", text: "I paid for my freedom. You just ran. We're not so different."),
    (id: "BARK_MESSLER_01", speaker: "messler", trigger: "food_burnt", text: "Burnt. Of course it's burnt."),
    (id: "BARK_MESSLER_02", speaker: "messler", trigger: "recipe_failed", text: "You call that stew?"),
    (id: "BARK_MESSLER_03", speaker: "messler", trigger: "recipe_made", text: "Oh look, it worked. Mark the calendar."),
    (id: "BARK_MESSLER_04", speaker: "messler", trigger: "talk", text: "Feed me and I might remember something useful."),
    (id: "BARK_MESSLER_05", speaker: "messler", trigger: "fed_recipe", text: "That's a new one. Write it in your book before you forget."),
    (id: "BARK_MESSLER_06", speaker: "messler", trigger: "fed", text: "A hundred and thirty years and I've never eaten worse."),
    (id: "BARK_MESSLER_07", speaker: "messler", trigger: "talk", text: "That court treated me like a party trick. I hope they choke on their towers."),
    (id: "BARK_ORRIN_01", speaker: "orrin", trigger: "forecast_rain", text: "Rain's coming."),
    (id: "BARK_ORRIN_02", speaker: "orrin", trigger: "forecast_clear", text: "Clear skies coming."),
    (id: "BARK_ORRIN_03", speaker: "orrin", trigger: "forecast_fog", text: "Fog's rolling in."),
    (id: "BARK_ORRIN_04", speaker: "orrin", trigger: "forecast_snow", text: "Snow's on the way."),
    (id: "BARK_ORRIN_05", speaker: "orrin", trigger: "forecast_gale", text: "A gale's coming. Tie things down."),
    (id: "BARK_ORRIN_06", speaker: "orrin", trigger: "forecast_storm", text: "Storm's coming. A big one."),
    (id: "BARK_ORRIN_07", speaker: "orrin", trigger: "weather_ends_soon", text: "This'll clear soon."),
    (id: "BARK_ORRIN_08", speaker: "orrin", trigger: "weather_lasts", text: "This one's staying a while."),
    (id: "BARK_ORRIN_09", speaker: "orrin", trigger: "idle", text: "Morning, clouds. Behave today."),
    (id: "BARK_BRIND_01", speaker: "brindlespheimer", trigger: "talk", text: "Go in. Come out. That is... the whole... arrangement."),
    (id: "BARK_BRIND_02", speaker: "brindlespheimer", trigger: "before_run", text: "Your body... will be safe... with me."),
    (id: "BARK_BRIND_03", speaker: "brindlespheimer", trigger: "idle", text: "I studied... spores... once. Or they... studied me."),
    (id: "BARK_BRIND_04", speaker: "brindlespheimer", trigger: "talk", text: "If you..."),
    (id: "BARK_SPORROW_01", speaker: "sporrow_folk", trigger: "near", text: "No fire past the stones."),
    (id: "BARK_SPORROW_02", speaker: "sporrow_folk", trigger: "talk", text: "Outsider."),
    // ---- Dialogue trees (dialogue.ron) ----
    (id: "MOSSA_GREET_01", speaker: "mossa", text: "Oh! Mind the moss, it bites back. Well, it sulks."),
    (id: "MOSSA_GREET_02", speaker: "mossa", text: "A dry face in the Great Swamp. That's rare as a straight reed."),
    (id: "MOSSA_GREET_03", speaker: "mossa", text: "Name's Mossa. Mossa Tarn. I trade, I wander, I talk too much."),
    (id: "MOSSA_AGAIN_01", speaker: "mossa", text: "Back again! The frogs said you would be. They lie, mostly, but not today."),
    (id: "MOSSA_HUB_01", speaker: "mossa", text: "What else is on your mind?"),
    (id: "MOSSA_TRADE_01", speaker: "mossa", text: "Reed rope, bog salt, a lens with only one crack in it."),
    (id: "MOSSA_TRADE_02", speaker: "mossa", text: "And stories. Stories are free. The rope is not."),
    (id: "MOSSA_LENS_01", speaker: "mossa", text: "Someone who wants to see two of everything!"),
    (id: "MOSSA_LENS_02", speaker: "mossa", text: "No, truly. Hold it to the stars and the crack splits them. Old charters used that trick."),
    (id: "MOSSA_SWAMP_01", speaker: "mossa", text: "It's older than the villages on their stilts. Older than the barrows, they say."),
    (id: "MOSSA_SWAMP_02", speaker: "mossa", text: "Keep a torch near you after dark. Things walk the reeds that don't like the light."),
    (id: "MOSSA_THINGS_01", speaker: "mossa", text: "Cold things. Wights from the barrows, mostly. They remember being people, and it makes them angry."),
    (id: "MOSSA_THINGS_02", speaker: "mossa", text: "Don't go into a barrow at night. Don't go into one in the day either, if you can help it."),
    (id: "MOSSA_BRAVE_01", speaker: "mossa", text: "Then you're a fool, and fools make short stories. Take a torch anyway."),
    (id: "MOSSA_FOLLOW_01", speaker: "mossa", text: "A walk! My legs were getting bored. Lead on, I'll keep up."),
    (id: "MOSSA_STAY_01", speaker: "mossa", text: "Right here? Fine. I'll count the frogs until you're back."),
    (id: "MOSSA_WANDER_01", speaker: "mossa", text: "Free as a bog moth. Come find me, I won't go far."),
    (id: "WARDEN_GREET_01", speaker: "warden", text: "Stop there, walker. That doorway is warded, and the ward does not know you."),
    (id: "WARDEN_GREET_02", speaker: "warden", text: "I am Ysolde. I keep this gate, and the dead below keep everything else."),
    (id: "WARDEN_GREET_03", speaker: "warden", text: "No living body passes the veil. Not with feet, not with a pick. The stones will not break for you."),
    (id: "WARDEN_AGAIN_01", speaker: "warden", text: "Back at the threshold. The halls have shifted their dust since you were here."),
    (id: "WARDEN_HOW_01", speaker: "warden", text: "I can lift your spirit out of your body for a while. Your body stays here with me, safe and sleeping on its feet."),
    (id: "WARDEN_HOW_02", speaker: "warden", text: "Your spirit walks the halls. It feels pain, it bleeds light, it can fall."),
    (id: "WARDEN_HOW_03", speaker: "warden", text: "If it falls, the ward spits it back out at this door and it settles into your body again. No harm done but pride."),
    (id: "WARDEN_WIN_01", speaker: "warden", text: "Then you walk back out the way you came, and your spirit comes home on its own."),
    (id: "WARDEN_WIN_02", speaker: "warden", text: "Whatever you learned down there, you keep. The halls keep everything else."),
    (id: "WARDEN_BELOW_01", speaker: "warden", text: "Long halls. Wide rooms. Things that were people once, and things that never were."),
    (id: "WARDEN_BELOW_02", speaker: "warden", text: "They guard the deepest hall hardest. Whatever sleeps there wakes for spirits."),
    (id: "WARDEN_CAST_01", speaker: "warden", text: "Hold still. Look at your hands, and don't look away."),
    (id: "BRAM_GREET_01", speaker: "bram", text: "Easy. I'm not here to drag you anywhere."),
    (id: "BRAM_GREET_02", speaker: "bram", text: "Bram Holloway. I know whose daughter you are, and I don't care. The court took enough from me."),
    (id: "BRAM_GREET_03", speaker: "bram", text: "You've got a bedroll and not much else. Let me help with that."),
    (id: "BRAM_AGAIN_01", speaker: "bram", text: "Still breathing. Good. What do you need?"),
    (id: "BRAM_HUB_01", speaker: "bram", text: "Anything else?"),
    (id: "BRAM_FIRST_01", speaker: "bram", text: "Sticks and fibre. A camp mat. Then rocks for an axe."),
    (id: "BRAM_FIRST_02", speaker: "bram", text: "The urn by your bedroll takes what you give it and makes it into something better. Feed it."),
    (id: "BRAM_WHY_01", speaker: "bram", text: "Because they'd want me not to."),
    (id: "BRAM_WHY_02", speaker: "bram", text: "The court burns what it can't own. You ran from it. That's enough for me."),
    (id: "BRAM_EXPLORE_01", speaker: "bram", text: "There's a gate of rotten stone not far from here. Mold all over it, a strange man in blue beside it."),
    (id: "BRAM_EXPLORE_02", speaker: "bram", text: "What's under it changes every time you go down. The things at the bottom guard old urns."),
    (id: "BRAM_FOLLOW_01", speaker: "bram", text: "Lead the way. I'll set myself down by your urn and keep the fire honest."),
    (id: "BRAM_STAY_01", speaker: "bram", text: "I'll be right here. Don't get yourself killed."),
    (id: "GILM_GREET_01", speaker: "gilm", text: "What. You're staring."),
    (id: "GILM_GREET_02", speaker: "gilm", text: "Yes, I'm a mushroom. Yes, I work a forge. Sporrow threw me out for it. Fire frightens them."),
    (id: "GILM_GREET_03", speaker: "gilm", text: "Name's Gilm. If you've come to laugh, laugh fast. I've work."),
    (id: "GILM_AGAIN_01", speaker: "gilm", text: "Hm. You again. Brought ore?"),
    (id: "GILM_HUB_01", speaker: "gilm", text: "Anything else?"),
    (id: "GILM_TOOLS_01", speaker: "gilm", text: "Better than yours. Better than anyone's on this rock."),
    (id: "GILM_TOOLS_02", speaker: "gilm", text: "Give me a proper forge and good metal and I'll show you."),
    (id: "GILM_SPORROW_01", speaker: "gilm", text: "Mold folk and fire don't mix. One spark and a whole village goes up like dry moss."),
    (id: "GILM_SPORROW_02", speaker: "gilm", text: "I only wanted to make things. They wanted me gone. So I'm gone."),
    (id: "GILM_FOLLOW_01", speaker: "gilm", text: "A forge? A real one? ...Fine. Show me. If it's a pile of rocks I'm leaving."),
    (id: "GILM_STAY_01", speaker: "gilm", text: "Fine. I'll stand here like a stump."),
    (id: "GILM_COMMISSION_01", speaker: "gilm", text: "Bring the metal, I'll make what you can't. What'll it be?"),
    (id: "GILM_COMMISSION_DONE_01", speaker: "gilm", text: "There. One {made}. Better than you'd ever manage."),
    (id: "GILM_COMMISSION_SHORT_01", speaker: "gilm", text: "You're short. I need {missing} more. I don't work for nothing."),
    (id: "WREN_GREET_01", speaker: "wren", text: "Oh, a customer! Don't mind the oil, she leaks when she's happy."),
    (id: "WREN_GREET_02", speaker: "wren", text: "Wren Calloway. I buy, I sell, I fly. Mostly I haggle."),
    (id: "WREN_GREET_03", speaker: "wren", text: "Where have I been? Here and there. Mostly there."),
    (id: "WREN_AGAIN_01", speaker: "wren", text: "There you are! Got coin, or got stories? I take both."),
    (id: "WREN_HUB_01", speaker: "wren", text: "Anything else?"),
    (id: "WREN_SELL_01", speaker: "wren", text: "Today? Rope, bolts, a fan blade that's only a little bent."),
    (id: "WREN_SELL_02", speaker: "wren", text: "Tomorrow, who knows. Depends where the wind takes me."),
    (id: "WREN_FLY_01", speaker: "wren", text: "Everywhere and nowhere you'd find on a map."),
    (id: "WREN_FLY_02", speaker: "wren", text: "A trader who tells you where her stock comes from isn't a trader for long."),
    (id: "WREN_FOLLOW_01", speaker: "wren", text: "A spot for my machine and a steady customer? Done. Show me where."),
    (id: "WREN_STAY_01", speaker: "wren", text: "I'll wait. Not long, mind. Time's coin."),
    (id: "WREN_TRADE_01", speaker: "wren", text: "Today's stock. Take it or leave it. Mostly take it."),
    (id: "WREN_TRADE_DONE_01", speaker: "wren", text: "Pleasure doing business. {got}, as promised."),
    (id: "WREN_TRADE_SHORT_01", speaker: "wren", text: "You're short {missing}. No credit, sorry. Not even for you."),
    (id: "LIORA_GREET_01", speaker: "liora", text: "Well. I know that face. Half the court would pay a fortune to see it again."),
    (id: "LIORA_GREET_02", speaker: "liora", text: "Don't worry, I'm not one of them. Not any more. Liora Vance. I bought my way out and left in the night."),
    (id: "LIORA_GREET_03", speaker: "liora", text: "Same as you, I think."),
    (id: "LIORA_AGAIN_01", speaker: "liora", text: "Your Highness. Joking. Mostly."),
    (id: "LIORA_HUB_01", speaker: "liora", text: "Anything else?"),
    (id: "LIORA_COURT_01", speaker: "liora", text: "Listened. People tell a courtesan everything, and forget she was in the room."),
    (id: "LIORA_COURT_02", speaker: "liora", text: "I learned which lords owed what, and to whom. It bought my freedom."),
    (id: "LIORA_SEW_01", speaker: "liora", text: "Can I sew? I dressed half the court and mended the other half."),
    (id: "LIORA_SEW_02", speaker: "liora", text: "Give me cloth and hide and a table, and you'll look like someone worth hunting."),
    (id: "LIORA_FOLLOW_01", speaker: "liora", text: "With a runaway heir and a pile of urns? How could I refuse. Lead on."),
    (id: "LIORA_STAY_01", speaker: "liora", text: "I'll wait. Don't keep a lady waiting too long."),
    (id: "LIORA_COURT_LORDS_01", speaker: "liora", text: "The regent, in name. In truth, whoever paid him last."),
    (id: "LIORA_COURT_LORDS_02", speaker: "liora", text: "Three houses circle the throne like crows round a fence post. None of them trusts the others, so none of them moves."),
    (id: "LIORA_COURT_LORDS_03", speaker: "liora", text: "It's held for years like that. It won't hold forever."),
    (id: "LIORA_COURT_HEIR_01", speaker: "liora", text: "Of course they do. A missing heir is the best gossip there is."),
    (id: "LIORA_COURT_HEIR_02", speaker: "liora", text: "Some say you're dead. Some say you're mad. The ones who pay best ask where you are."),
    (id: "LIORA_COURT_HEIR_03", speaker: "liora", text: "I never tell them. A good courtesan knows what not to sell."),
    (id: "LIORA_COMMISSION_01", speaker: "liora", text: "Bring me the cloth and I'll do the rest. What would you like?"),
    (id: "LIORA_COMMISSION_DONE_01", speaker: "liora", text: "There. A {made}. Try not to bleed on it."),
    (id: "LIORA_COMMISSION_SHORT_01", speaker: "liora", text: "I can't sew from thin air, darling. I need {missing} more."),
    (id: "MESSLER_GREET_01", speaker: "messler", text: "Don't step on me. People always step on me. One hundred and thirty years of being stepped on."),
    (id: "MESSLER_GREET_02", speaker: "messler", text: "Messler. A wizard of the court made me think, then made me wish I couldn't."),
    (id: "MESSLER_GREET_03", speaker: "messler", text: "Are you going to eat that? You look like you burn things."),
    (id: "MESSLER_AGAIN_01", speaker: "messler", text: "Oh. You. Did you bring food, or just your face?"),
    (id: "MESSLER_HUB_01", speaker: "messler", text: "Anything else?"),
    (id: "MESSLER_WIZARD_01", speaker: "messler", text: "A court wizard with soft hands and a hard heart. I was his experiment. Then his footstool."),
    (id: "MESSLER_WIZARD_02", speaker: "messler", text: "I've no idea if I can die. I've stopped asking."),
    (id: "MESSLER_COOK_01", speaker: "messler", text: "Better than you, and I've only got paws."),
    (id: "MESSLER_COOK_02", speaker: "messler", text: "Feed me and I might even tell you how."),
    (id: "MESSLER_FOLLOW_01", speaker: "messler", text: "A fire and someone to feed me? Lead on. Mind the tail."),
    (id: "MESSLER_STAY_01", speaker: "messler", text: "Fine. I'll sit here and starve politely."),
    (id: "MESSLER_FED_01", speaker: "messler", text: "Mm. Fine. Fine! Here's one for you, then: {recipe}."),
    (id: "MESSLER_FED_02", speaker: "messler", text: "Pot, fire, stir. Don't burn it."),
    (id: "MESSLER_FED_ALL_01", speaker: "messler", text: "Mm. I've taught you all I'll teach. Thanks all the same."),
    (id: "MESSLER_NO_FOOD_01", speaker: "messler", text: "With what? You've nothing to eat on you. Cruel."),
    (id: "ORRIN_GREET_01", speaker: "orrin", text: "Shh. The clouds were telling me something."),
    (id: "ORRIN_GREET_02", speaker: "orrin", text: "Ah, it's gone now. Never mind. I'm Orrin. I watch the sky. Someone ought to."),
    (id: "ORRIN_GREET_03", speaker: "orrin", text: "You walk like someone with the wind at her back. Running, are you?"),
    (id: "ORRIN_AGAIN_01", speaker: "orrin", text: "The sky's been talking about you."),
    (id: "ORRIN_HUB_01", speaker: "orrin", text: "Anything else?"),
    (id: "ORRIN_CLOUDS_01", speaker: "orrin", text: "Mostly, rain. Sometimes, more rain."),
    (id: "ORRIN_CLOUDS_02", speaker: "orrin", text: "But listen long enough and they tell you what's coming, and when it'll pass."),
    (id: "ORRIN_ALONE_01", speaker: "orrin", text: "The castle was empty. So was I. We suit each other."),
    (id: "ORRIN_ALONE_02", speaker: "orrin", text: "Up here there's nothing between me and the sky."),
    (id: "ORRIN_FOLLOW_01", speaker: "orrin", text: "A new sky to read. Why not. I'll follow."),
    (id: "ORRIN_STAY_01", speaker: "orrin", text: "I'll stay and count the clouds."),
    (id: "ORRIN_WEATHER_01", speaker: "orrin", text: "{now} now. It clears {clears}."),
    (id: "ORRIN_WEATHER_02", speaker: "orrin", text: "After that, {next}."),
    (id: "ORRIN_WEATHER_STILL_01", speaker: "orrin", text: "{now}, and it's staying. I can't see an end to it."),
    (id: "TALLOW_GREET_01", speaker: "tallow", text: "A spirit with coin! My favourite kind."),
    (id: "TALLOW_GREET_02", speaker: "tallow", text: "Tallow. I sell to whoever gets this far down."),
    (id: "TALLOW_TRADE_01", speaker: "tallow", text: "Old coin only. The living kind is no use down here."),
    (id: "TALLOW_TRADE_DONE_01", speaker: "tallow", text: "{got}. Try not to drop it on the way up."),
    (id: "TALLOW_TRADE_SHORT_01", speaker: "tallow", text: "You're short {missing}. Come back richer."),
    (id: "BRINDLESPHEIMER_GREET_01", speaker: "brindlespheimer", text: "Hello."),
    (id: "BRINDLESPHEIMER_GREET_02", speaker: "brindlespheimer", text: "I am Brindlespheimer. I think."),
    (id: "BRINDLESPHEIMER_GREET_03", speaker: "brindlespheimer", text: "I do not remember how I came to this island. The mold remembers. It does not say."),
    (id: "BRINDLESPHEIMER_GREET_04", speaker: "brindlespheimer", text: "Only a spirit goes down. I can take you out of your body."),
    (id: "BRINDLESPHEIMER_AGAIN_01", speaker: "brindlespheimer", text: "Hello again. Or for the first time. They are all doors."),
    (id: "BRINDLESPHEIMER_AGAIN_02", speaker: "brindlespheimer", text: "I stand where you are going. It saves walking."),
    (id: "BRINDLESPHEIMER_HUB_01", speaker: "brindlespheimer", text: "Anything else?"),
    (id: "BRINDLESPHEIMER_RULES_01", speaker: "brindlespheimer", text: "How it works. I will say it plainly."),
    (id: "BRINDLESPHEIMER_RULES_02", speaker: "brindlespheimer", text: "Only a spirit goes down. I take you out of your body. Your body waits here with me."),
    (id: "BRINDLESPHEIMER_RULES_03", speaker: "brindlespheimer", text: "Down there are rooms and halls. Walk into a room with foes and the doors slam shut. Beat every one and they open again. There is always a way on."),
    (id: "BRINDLESPHEIMER_RULES_04", speaker: "brindlespheimer", text: "Each floor has a boss. When it falls it drops a key. The key opens the stair down, in the boss's own room."),
    (id: "BRINDLESPHEIMER_RULES_05", speaker: "brindlespheimer", text: "You can climb out the way you came in, or by the exit in the boss's room once it falls. What you carry out, you keep."),
    (id: "BRINDLESPHEIMER_RULES_06", speaker: "brindlespheimer", text: "If your spirit falls, you wake here. Whatever you found down there stays down there."),
    (id: "BRINDLESPHEIMER_RULES_07", speaker: "brindlespheimer", text: "A room with a campfire mends you. Chests open by hand. The walls will not break: dungeons are protected from mining."),
    (id: "BRINDLESPHEIMER_ROTTING_BOG_01", speaker: "brindlespheimer", text: "This one rots. Moss, mud, things that like both."),
    (id: "BRINDLESPHEIMER_ROTTING_BOG_02", speaker: "brindlespheimer", text: "The floors shut behind you when you fight. They open when it is quiet again."),
    (id: "BRINDLESPHEIMER_FLOODED_CRYPT_01", speaker: "brindlespheimer", text: "A crypt. The water got in and the dead did not mind."),
    (id: "BRINDLESPHEIMER_FLOODED_CRYPT_02", speaker: "brindlespheimer", text: "Mind the darts in the walls. They are old, and still unkind."),
    (id: "BRINDLESPHEIMER_ROOT_CHOKED_HALL_01", speaker: "brindlespheimer", text: "Roots came down through the roof and took the hall. They are still taking."),
    (id: "BRINDLESPHEIMER_ROOT_CHOKED_HALL_02", speaker: "brindlespheimer", text: "The floor is soft in places. Soft floors go down."),
    (id: "BRINDLESPHEIMER_COLLAPSED_MINE_01", speaker: "brindlespheimer", text: "A mine. Someone dug too deep and the deep dug back."),
    (id: "BRINDLESPHEIMER_COLLAPSED_MINE_02", speaker: "brindlespheimer", text: "There is powder in the barrels. Hit one and step away. Further than that."),
    (id: "BRINDLESPHEIMER_FROZEN_VAULT_01", speaker: "brindlespheimer", text: "The castle's vault. It is cold the way a held breath is cold."),
    (id: "BRINDLESPHEIMER_FROZEN_VAULT_02", speaker: "brindlespheimer", text: "Blades on chains, and things that were people once. It is the last of them."),
    (id: "BRINDLESPHEIMER_HERE_FLOORS", speaker: "brindlespheimer", text: "It is {dungeon}. {floors} floors down."),
    (id: "BRINDLESPHEIMER_BOSS_01", speaker: "brindlespheimer", text: "At the bottom waits {boss}."),
    (id: "BRINDLESPHEIMER_BOSS_02", speaker: "brindlespheimer", text: "It is not waiting for you. It is just waiting."),
    (id: "BRINDLESPHEIMER_ADVICE_01", speaker: "brindlespheimer", text: "The boss of each floor carries its key. No boss, no stair."),
    (id: "BRINDLESPHEIMER_ADVICE_02", speaker: "brindlespheimer", text: "{hint}"),
    (id: "BRINDLESPHEIMER_ADVICE_03", speaker: "brindlespheimer", text: "Kick things into the traps. The traps do not mind who."),
    (id: "BRINDLESPHEIMER_CLEARED_01", speaker: "brindlespheimer", text: "I know. The mold told me. It is quieter down there now."),
    (id: "BRINDLESPHEIMER_CLEARED_02", speaker: "brindlespheimer", text: "The worst of it will not come back. The rest always does."),
    (id: "BRINDLESPHEIMER_HELP_01", speaker: "brindlespheimer", text: "I can take you out of your body. The body waits here. It keeps its wounds."),
    (id: "BRINDLESPHEIMER_HELP_02", speaker: "brindlespheimer", text: "If the spirit falls, it wakes back here. What it found down there stays down there."),
]
