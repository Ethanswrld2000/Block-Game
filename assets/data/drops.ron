// What breaking a block gives you: block name -> [(item, count, chance 0..1)].
// A block that isn't listed drops its own item (the item that places it), if there is one.
// An empty list drops nothing.
{
    // Stone breaks into small rocks; cobblestone is made from them at the tool bench.
    "stone": [("small_rock", 2, 1.0), ("small_rock", 1, 0.5)],
    // Logs give raw wood, not the log block.
    "log": [("raw_wood", 2, 1.0)],
    "swamp_log": [("raw_wood", 2, 1.0)],
    "redwood_log": [("raw_wood", 2, 1.0)],
    "grass": [("dirt", 1, 1.0), ("plant_fiber", 1, 0.5), ("swamp_reed", 1, 0.08)],
    "moss": [("moss", 1, 1.0), ("plant_fiber", 1, 0.35)],
    "leaves": [("stick", 1, 0.5), ("plant_fiber", 1, 0.3)],
    "swamp_leaves": [("stick", 1, 0.4), ("plant_fiber", 1, 0.3), ("marsh_berries", 1, 0.12)],
    "gravel": [("gravel", 1, 1.0), ("flint", 1, 0.2)],
    "coal_ore": [("coal", 1, 1.0)],
    "iron_ore": [("raw_iron", 1, 1.0)],
    "deeprock": [("small_rock", 2, 1.0), ("small_rock", 1, 0.5)],
    "snow": [],
    "ice": [],
    "water": [],
    "tall_grass": [("plant_fiber", 1, 0.4), ("barley_seeds", 1, 0.15)],
    "reeds": [("plant_fiber", 1, 0.6), ("swamp_reed", 1, 0.25)],
    "fern": [("plant_fiber", 1, 0.3), ("tuber_eye", 1, 0.1)],
    // Crops: unripe ones give back what was sown, ripe ones the harvest.
    "barley_0": [("barley_seeds", 1, 1.0)],
    "barley_1": [("barley_seeds", 1, 1.0)],
    "barley_2": [("barley", 3, 1.0), ("barley_seeds", 2, 1.0), ("barley_seeds", 1, 0.5)],
    "tuber_0": [("tuber_eye", 1, 1.0)],
    "tuber_1": [("tuber_eye", 1, 1.0)],
    "tuber_2": [("mire_tuber", 2, 1.0), ("tuber_eye", 1, 1.0), ("mire_tuber", 1, 0.4)],
    "bog_bloom": [("plant_fiber", 1, 0.2)],
    "shrub": [("stick", 1, 0.5), ("plant_fiber", 1, 0.4)],
    "dry_brush": [("stick", 1, 0.6)],
    "brown_mushroom": [("plant_fiber", 1, 0.2)],
    "glowcap": [("plant_fiber", 1, 0.2)],
    "redwood_leaves": [("stick", 1, 0.5), ("plant_fiber", 1, 0.3)],
    // Tree details and pebbles (right click picks them up, or break them).
    "twig_north": [("stick", 1, 1.0)],
    "twig_south": [("stick", 1, 1.0)],
    "twig_east": [("stick", 1, 1.0)],
    "twig_west": [("stick", 1, 1.0)],
    "vine_north": [("plant_fiber", 1, 0.4)],
    "vine_south": [("plant_fiber", 1, 0.4)],
    "vine_east": [("plant_fiber", 1, 0.4)],
    "vine_west": [("plant_fiber", 1, 0.4)],
    "pebble": [("small_rock", 1, 1.0)],
    "wooden_door_open": [("wooden_door", 1, 1.0)],
    // Felled logs lying on their side give raw wood too.
    "log_x": [("raw_wood", 2, 1.0)],
    "log_z": [("raw_wood", 2, 1.0)],
    "swamp_log_x": [("raw_wood", 2, 1.0)],
    "swamp_log_z": [("raw_wood", 2, 1.0)],
    "redwood_log_x": [("raw_wood", 2, 1.0)],
    "redwood_log_z": [("raw_wood", 2, 1.0)],
    // Soil dug by hand gives its block when the last layer goes; a shovel on a dug layer gives it too.
    "dirt_layer_6": [("dirt", 1, 1.0)], "dirt_layer_4": [("dirt", 1, 1.0)], "dirt_layer_2": [("dirt", 1, 1.0)],
    "sand_layer_6": [("sand", 1, 1.0)], "sand_layer_4": [("sand", 1, 1.0)], "sand_layer_2": [("sand", 1, 1.0)],
    "mud_layer_6": [("mud", 1, 1.0)], "mud_layer_4": [("mud", 1, 1.0)], "mud_layer_2": [("mud", 1, 1.0)],
    "gravel_layer_6": [("gravel", 1, 1.0)], "gravel_layer_4": [("gravel", 1, 1.0)], "gravel_layer_2": [("gravel", 1, 1.0)],
    "clay_layer_6": [("clay", 1, 1.0)], "clay_layer_4": [("clay", 1, 1.0)], "clay_layer_2": [("clay", 1, 1.0)],
    "peat_layer_6": [("peat", 1, 1.0)], "peat_layer_4": [("peat", 1, 1.0)], "peat_layer_2": [("peat", 1, 1.0)],
}
