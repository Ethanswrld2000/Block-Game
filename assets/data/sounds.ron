// Which sounds a block's material makes. Footsteps pick one of `<step>_0`, `_1`, `_2`
// at random; mining plays `dig` with every blow. Files live in assets/sounds/
// (placeholders from tools/gen_placeholder_sounds.py; replace any by name).
(
    materials: {
        "soil": (step: "step_soft", dig: "dig_soft"),
        "stone": (step: "step_hard", dig: "dig_hard"),
        "ore": (step: "step_hard", dig: "dig_hard"),
        "wood": (step: "step_wood", dig: "dig_wood"),
        "log": (step: "step_wood", dig: "dig_wood"),
        "plant": (step: "step_plant", dig: "dig_plant"),
    },
    fallback: (step: "step_soft", dig: "dig_soft"),
    // Loudness of each sound before the volume setting, 0..1.
    volumes: {
        "step": 0.35,
        "dig": 0.5,
        "break": 0.6,
        "place": 0.5,
        "hit": 0.7,
        "creature_hurt": 0.5,
        "hurt": 0.7,
        "spirit": 0.45,
        "spell_on": 0.5,
        "spell_off": 0.4,
        "level_up": 0.6,
        // NPC speech blips (voice_0..3), one per syllable.
        "voice": 0.45,
        // Inventory clicks (ui_open, ui_close, ui_tab, ui_pick, ui_drop, ui_equip),
        // and drawing / putting away the weapon (ui_draw, ui_sheathe).
        "ui": 0.35,
        // Working the cooking pot and the cutting board.
        "stir": 0.55,
        "knife": 0.55,
        // A bench finishing something.
        "craft_shimmer": 0.45,
        "craft_pop": 0.7,
        "thunder": 0.9,
        "wind_loop": 0.5,
        "rain_loop": 0.5,
        "levitate_loop": 0.35,
        // Critters (also scaled by the ambience setting and their distance).
        "bird": 0.45,
        "frog": 0.5,
        "cricket": 0.3,
        "kite": 0.4,
        // Music (also scaled by the music setting).
        "music": 0.6,
    },
    // Music tracks (assets/sounds/<name>.ogg), one now and then with quiet between:
    // `day` tracks while the sun is up, `night` ones after dark. Placeholders from
    // tools/gen_placeholder_sounds.py --only music_; replace them by name or add more.
    music: (day: ["music_day_0", "music_day_1"], night: ["music_night_0"], gap: (150.0, 360.0), first: 45.0),
)
