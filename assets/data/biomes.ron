        temperature: 0.8, humidity: -0.8, min_height: -4, max_height: 40,
        surface: "sand", subsurface: "sand", underwater: "sand",
        trees: none, tree_chance: 0.0, fog: (0.86, 0.8, 0.66),
        plants: [(block: "dry_brush", chance: 0.05)],
    ),
    (
        name: "pine_hills", title: "Pine Forest",
        temperature: -0.5, humidity: 0.2, min_height: 1, max_height: 90,
        surface: "grass", subsurface: "dirt", underwater: "gravel",
        trees: pine, tree_chance: 0.035, bushes: 0.025, fog: (0.6, 0.68, 0.75),
        plants: [(block: "fern", chance: 0.14), (block: "shrub", chance: 0.06), (block: "tall_grass", chance: 0.3)],
