// Biomes. Titles are plain names shown in game. temperature/humidity only decide where a
// biome goes; they do not change the temperature you feel.
// Each column picks the biome whose climate point (temperature,
// humidity, both -1..1) is nearest, among biomes whose elevation band contains
// the column's height above sea level. Order does not matter.
//   surface / subsurface / underwater: block names from blocks.ron
//   trees: swamp, oak, pine, redwood, mushroom or none;  tree_chance: per column, 0..1 (at most 0.05)
//   bushes: optional, chance per column (at most 0.05) of a leafy bush made of the trees' leaves
//   fog: RGB 0..1, the colour the sky and fog lean towards here
//   haze: optional, default 1; how far you can see (0.5 = half as far)
//   plants: optional ground plants (blocks with `shape: plant`), tried in order on
//           each surface block: (block, chance per block 0..1, shore: true = only
//           on ground at most one block above sea level). Patch noise clumps them.
//   region: optional, where it can appear: main (default, the main island), outer (the
//           islands past the coast; they use main biomes if none are listed), sky (sky
//           islands, one biome per island) or air (open air: the void between islands
//           and high above the land). Heights for outer/sky count from the island's base.
//   guaranteed: optional, Some((radius, near, far)): placed once per world on the main
//           island, `near..far` blocks from spawn, whatever the climate (only on ground
//           inside its height band). Never picked by climate. Main island only.
[
    (
        name: "great_swamp", title: "Swamp",
        temperature: 0.4, humidity: 0.8, min_height: -3, max_height: 10,
        surface: "moss", subsurface: "peat", underwater: "mud",
        trees: swamp, tree_chance: 0.016, bushes: 0.03, fog: (0.46, 0.53, 0.47), haze: 0.4,
        plants: [(block: "reeds", chance: 0.6, shore: true), (block: "fern", chance: 0.2), (block: "shrub", chance: 0.06), (block: "bog_bloom", chance: 0.04), (block: "tall_grass", chance: 0.35)],
    ),
    (
        name: "mossy_woods", title: "Oak Forest",
        temperature: 0.1, humidity: 0.35, min_height: 1, max_height: 70,
        surface: "grass", subsurface: "dirt", underwater: "clay",
        trees: oak, tree_chance: 0.04, bushes: 0.04, fog: (0.55, 0.65, 0.6), haze: 0.8,
        plants: [(block: "fern", chance: 0.22), (block: "shrub", chance: 0.08), (block: "tall_grass", chance: 0.4)],
    ),
    (
        name: "meadow", title: "Meadow",
        temperature: 0.2, humidity: -0.3, min_height: 1, max_height: 70,
        surface: "grass", subsurface: "dirt", underwater: "gravel",
        trees: oak, tree_chance: 0.003, bushes: 0.012, fog: (0.7, 0.78, 0.86),
        plants: [(block: "bog_bloom", chance: 0.05), (block: "shrub", chance: 0.03), (block: "tall_grass", chance: 0.75)],
