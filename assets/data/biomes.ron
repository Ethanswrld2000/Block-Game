// Biomes. Each column picks the biome whose climate point (temperature,
// humidity, both -1..1) is nearest, among biomes whose elevation band contains
// the column's height above sea level. Order does not matter.
//   surface / subsurface / underwater: block names from blocks.ron
//   trees: swamp, "oak", "pine" or "none";  tree_chance: per column, 0..1
//   fog: RGB 0..1, the colour the sky and fog lean towards here
//   haze: optional, default 1; how far you can see (0.5 = half as far)
[
    (
        name: "great_swamp", title: "The Great Swamp",
        temperature: 0.4, humidity: 0.8, min_height: -3, max_height: 10,
        surface: "moss", subsurface: "peat", underwater: "mud",
        trees: swamp, tree_chance: 0.012, fog: (0.46, 0.53, 0.47), haze: 0.4,
