        ("spirit_ember", 1, 3, 0.6),
        ("flint_spear", 1, 1, 0.3),
        ("bark_helm", 1, 1, 0.25),
        ("hide_jerkin", 1, 1, 0.2),
        ("fur_hood", 1, 1, 0.2),
        ("raw_iron", 1, 4, 0.5),
