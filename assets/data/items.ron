// Items. The hotbar (keys 1-9) holds shortcuts to things in your inventory;
// open the inventory with Tab.
//   title:  shown on screen
//   kind:   Tool(speeds: {material: multiplier}), Block("block name"), Torch,
//           Food(tier: 1-4, satiety: 0-100) (tiers are in food_tiers.ron),
//           Wear(slot: Head|HeadArmor|Body|BodyArmor|Legs|Feet, insulation: °C,
//                protection: {Damage: 0.2, Blood: 0.1, Injuries: 0.1}) - the share of a blow kept
//                off the bar where it lands,
//           Bag(grid: (w, h)) - worn on the back, holds a grid of that size,
//           Material - for crafting (recipes.ron)
//   mass:   kg each (default 0.5)
//   size:   cells in a grid, (width, height) (default (1, 1)); R rotates while you hold it
//   stack:  how many share one cell (defaults: blocks and materials 32, torches 16, food 8, else 1)
//   damage: how hard it hits a creature (defaults: tools 4, anything else 2, like a fist)
// Pictures: every item has a sprite in assets/textures/icons/ (items.png, weapons.png for
// tools, blocks.png for blocks), 20 px per cell of its size. The same sprite is the held model.
// After adding an item, run `python3 tools/gen_item_art.py` to give it a placeholder sprite.
// Breaking takes hardness (blocks.ron) / speed seconds. A missing material
// uses the bare-hand speed below; a missing entry there is 1.
(
    // Logs (material "log") need an axe: bare hands and other tools can't cut them.
    hand: { "stone": 0.3, "ore": 0.25, "log": 0.0 },
    items: [
        (
            name: "stone_pickaxe", title: "Stone Pickaxe", mass: 2.5, size: (2, 3), damage: 5.0,
            kind: Tool(speeds: { "stone": 4.0, "ore": 3.5, "soil": 1.3 }),
        ),
        (
            name: "stone_axe", title: "Stone Axe", mass: 2.0, size: (1, 3), damage: 7.0,
            kind: Tool(speeds: { "log": 4.0, "wood": 4.0, "plant": 3.0 }),
        ),
        (
            name: "stone_shovel", title: "Stone Shovel", mass: 1.8, size: (1, 3), damage: 4.0,
            kind: Tool(speeds: { "soil": 4.0 }),
        ),
        (name: "torch", title: "Torch", mass: 0.4, size: (1, 2), kind: Torch),
        (name: "dirt", title: "Dirt", kind: Block("dirt"), mass: 1.5),
        (name: "planks", title: "Planks", kind: Block("planks"), mass: 1.0),
        (name: "cobblestone", title: "Cobblestone", kind: Block("cobblestone"), mass: 2.0),
        (name: "log", title: "Log", kind: Block("log"), mass: 2.0),
        (name: "moss", title: "Moss", kind: Block("moss"), mass: 0.5),
        // Food. Tier 1 is a quick buff, tier 4 can pull you back from a mortal wound.
        (name: "marsh_berries", title: "Marsh Berries", kind: Food(tier: 1, satiety: 6.0), mass: 0.2),
        (name: "swamp_reed", title: "Swamp Reed Hearts", kind: Food(tier: 1, satiety: 8.0), mass: 0.3),
        (name: "smoked_fish", title: "Smoked Fish", kind: Food(tier: 2, satiety: 25.0), mass: 0.6, size: (2, 1), stack: 4),
        (name: "bread", title: "Bread", kind: Food(tier: 2, satiety: 30.0), mass: 0.5),
        (name: "peat_stew", title: "Peat-Smoked Stew", kind: Food(tier: 3, satiety: 45.0), mass: 1.2, size: (1, 2), stack: 2),
        (name: "cured_meat", title: "Cured Meat", kind: Food(tier: 3, satiety: 40.0), mass: 0.8),
        (name: "feast_platter", title: "Feast Platter", kind: Food(tier: 4, satiety: 100.0), mass: 3.0, size: (2, 2), stack: 1),
        (name: "ember_herb", title: "Ember Herb", kind: Food(tier: 4, satiety: 5.0), mass: 0.1),
        // More blocks you can mine and place.
        (name: "mud", title: "Mud", kind: Block("mud"), mass: 1.8),
        (name: "peat", title: "Peat", kind: Block("peat"), mass: 1.2),
        (name: "sand", title: "Sand", kind: Block("sand"), mass: 1.6),
        (name: "gravel", title: "Gravel", kind: Block("gravel"), mass: 1.8),
        (name: "clay", title: "Clay", kind: Block("clay"), mass: 1.8),
        (name: "swamp_log", title: "Swamp Log", kind: Block("swamp_log"), mass: 2.0),
        (name: "skystone", title: "Skystone", kind: Block("skystone"), mass: 1.5),
        (name: "cloud_moss", title: "Cloud Moss", kind: Block("cloud_moss"), mass: 0.3),
        (name: "chest", title: "Chest", kind: Block("chest"), mass: 6.0, size: (2, 2), stack: 1),
        // Crafting materials.
        (name: "stick", title: "Stick", kind: Material, mass: 0.1, size: (1, 2)),
        (name: "plant_fiber", title: "Plant Fiber", kind: Material, mass: 0.05),
        (name: "cordage", title: "Cordage", kind: Material, mass: 0.1),
        (name: "coal", title: "Coal", kind: Material, mass: 0.3),
        (name: "raw_iron", title: "Raw Iron", kind: Material, mass: 0.8),
        (name: "flint", title: "Flint", kind: Material, mass: 0.2),
        (name: "small_rock", title: "Small Rock", kind: Material, mass: 0.3),
        (name: "hide", title: "Hide", kind: Material, mass: 1.0, size: (2, 2), stack: 4),
        (name: "fur", title: "Fur", kind: Material, mass: 0.6, size: (2, 2), stack: 4),
        // Clothes keep you warm; armor keeps blows off your health bars.
        (name: "linen_shirt", title: "Linen Shirt", mass: 0.4, size: (2, 2), kind: Wear(slot: Body, insulation: 2.0)),
        (
            name: "linen_trousers", title: "Linen Trousers", mass: 0.4, size: (2, 2),
            kind: Wear(slot: Legs, insulation: 2.0),
        ),
        (
            name: "hide_boots", title: "Hide Boots", mass: 0.8, size: (2, 1),
            kind: Wear(slot: Feet, insulation: 2.0, protection: { Damage: 0.03 }),
        ),
        (name: "reed_hat", title: "Reed Hat", mass: 0.2, size: (2, 1), kind: Wear(slot: Head, insulation: 1.0)),
        (name: "reed_cloak", title: "Reed Cloak", mass: 1.2, size: (2, 3), kind: Wear(slot: Body, insulation: 5.0)),
        (name: "fur_hood", title: "Fur Hood", mass: 0.5, size: (2, 2), kind: Wear(slot: Head, insulation: 5.0)),
        (
            name: "fur_coat", title: "Fur Coat", mass: 3.0, size: (2, 3),
            kind: Wear(slot: Body, insulation: 12.0, protection: { Damage: 0.05 }),
        ),
        (
            name: "hide_leggings", title: "Hide Leggings", mass: 1.5, size: (2, 2),
            kind: Wear(slot: Legs, insulation: 5.0, protection: { Damage: 0.05 }),
        ),
        (
            name: "bark_helm", title: "Bark Helm", mass: 1.5, size: (2, 2),
            kind: Wear(slot: HeadArmor, protection: { Damage: 0.15, Injuries: 0.1 }),
        ),
        (
            name: "bark_vest", title: "Bark Vest", mass: 4.0, size: (2, 3),
            kind: Wear(slot: BodyArmor, insulation: 1.0, protection: { Damage: 0.2, Blood: 0.15, Injuries: 0.05 }),
        ),
        (
            name: "hide_jerkin", title: "Hide Jerkin", mass: 3.0, size: (2, 3),
            kind: Wear(slot: BodyArmor, insulation: 2.0, protection: { Damage: 0.15, Blood: 0.3 }),
        ),
        // Bags are worn on the back and hold a grid of their own.
        (name: "reed_satchel", title: "Reed Satchel", mass: 0.6, size: (3, 3), kind: Bag(grid: (5, 4))),
        (name: "hide_pack", title: "Hide Pack", mass: 1.5, size: (4, 4), kind: Bag(grid: (7, 6))),
        // From creatures.
        (name: "raw_meat", title: "Raw Meat", kind: Food(tier: 1, satiety: 6.0), mass: 0.5, stack: 6),
        (name: "roast_meat", title: "Roast Meat", kind: Food(tier: 2, satiety: 30.0), mass: 0.4, stack: 6),
        (name: "spirit_ember", title: "Spirit Ember", kind: Material, mass: 0.05, stack: 16),
        (name: "old_coin", title: "Old Coin", kind: Material, mass: 0.02, stack: 64),
        // A weapon.
        (name: "flint_spear", title: "Flint Spear", mass: 1.6, size: (1, 4), damage: 10.0, kind: Tool(speeds: {})),
    ],
)
