// Fusion: the essence of an item. The ancestral urn at your sleeping station takes items in,
// adds up their fusion, and spends it on upgrades that place new stations beside it.
//
// kinds:    the types of fusion (name, title, colour of the urn's marks).
// items:    item name -> fusion it gives, per item. Items not listed can't go in the urn.
// upgrades: in order. `needs` is what the upgrade spends; `after` lists upgrades that must come
//           first; `station` is what it places by the urn (see game::station).
(
    kinds: [
        (name: "earth", title: "Earth", color: (0.55, 0.78, 0.36)),
        (name: "stone", title: "Stone", color: (0.72, 0.74, 0.78)),
        (name: "life", title: "Life", color: (0.9, 0.5, 0.42)),
        (name: "spirit", title: "Spirit", color: (0.55, 0.8, 0.95)),
    ],
    items: {
        "stick": { "earth": 1.0 },
        "plant_fiber": { "earth": 0.5 },
        "cordage": { "earth": 1.5 },
        "log": { "earth": 4.0 },
        "swamp_log": { "earth": 4.0 },
        "planks": { "earth": 1.0 },
        "dirt": { "earth": 0.5 },
        "moss": { "earth": 0.5 },
        "peat": { "earth": 1.0 },
        "small_rock": { "stone": 1.0 },
        "flint": { "stone": 2.0 },
        "cobblestone": { "stone": 1.0 },
        "coal": { "stone": 1.0, "earth": 1.0 },
        "raw_iron": { "stone": 3.0 },
        "marsh_berries": { "life": 1.0 },
        "swamp_reed": { "life": 1.0, "earth": 0.5 },
        "raw_meat": { "life": 2.0 },
        "hide": { "life": 3.0 },
        "fur": { "life": 3.0 },
        "spirit_ember": { "spirit": 2.0 },
        "old_coin": { "spirit": 1.0 },
    },
    upgrades: [
        (name: "tool_bench", title: "Tool Bench", needs: { "earth": 10.0 }, station: "tool_bench"),
        (name: "carpentry_bench", title: "Carpentry Bench", needs: { "earth": 40.0 }, after: ["tool_bench"], station: "carpentry_bench"),
    ],
)
