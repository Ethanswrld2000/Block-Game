            Say("bram", "C12_03"),
            Say("bram", "C12_04"),
            Fade(1.0, 2.0),
            Remove("bram"),
            Flag("bram_dead"),
            Place((from: Place("camp"), offset: (3.0, 0.0, 2.0)), "grave"),
            Swap(at: (from: Place("sporrow")), radius: 26, from: "mushroom_stem", to: "burnt_stem"),
            Swap(at: (from: Place("sporrow")), radius: 26, from: "mushroom_cap", to: "burnt_cap"),
