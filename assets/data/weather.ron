// Weather kinds. Each weather lasts `hours` (in-game hours, random between the
// two numbers; one in-game hour is 50 real seconds), then the next one, picked
// by the season's chances in seasons.ron, takes over. The clouds turn into the
// next weather's over the last minute before the change; the rest blends in
// over a minute after it. The HUD's top-right panel shows the
// weather and the time left. docs/WEATHER.md has the full table.
//   clouds:        share of the sky covered, 0..1
//   cloud_shade:   cloud brightness, 1 = white
//   visibility:    how far you can see in blocks, before biome haze
//   light:         multiplies sunlight
//   precipitation: rain or snow amount, 0..1 (snow where it's below freezing)
//   wind:          wind strength, blocks per second: rain and snow drift with it,
//                  grass and leaves sway with it, clouds drift with its square
//                  root (a gale moves them faster, not wildly); its direction
//                  turns slowly by itself (see crates/game/src/wind.rs)
//   lightning:     true for thunderstorms
//   chill:         added to the felt temperature, °C (wet and wind feel colder)
//   air:           how breathable the air is, 1 = normal (swamp spores in mist,
//                  gale winds in storms make it harder to breathe)
[
    (name: "clear", title: "Clear", hours: (6.0, 14.0), clouds: 0.1, cloud_shade: 1.0,
     visibility: 1400.0, light: 1.0, precipitation: 0.0, wind: 3.0, lightning: false),
    (name: "overcast", title: "Overcast", hours: (4.0, 10.0), clouds: 0.75, cloud_shade: 0.8,
     visibility: 900.0, light: 0.55, precipitation: 0.0, wind: 5.0, lightning: false, chill: -1.0),
    (name: "rain", title: "Rain", hours: (3.0, 8.0), clouds: 0.9, cloud_shade: 0.6,
     visibility: 260.0, light: 0.35, precipitation: 0.7, wind: 6.0, lightning: false, chill: -4.0),
    (name: "storm", title: "Thunderstorm", hours: (3.0, 6.0), clouds: 1.0, cloud_shade: 0.4,
     visibility: 170.0, light: 0.2, precipitation: 1.0, wind: 12.0, lightning: true, chill: -7.0, air: 0.9),
    (name: "mist", title: "Mist", hours: (3.0, 7.0), clouds: 0.5, cloud_shade: 0.9,
     visibility: 70.0, light: 0.7, precipitation: 0.0, wind: 1.0, lightning: false, chill: -2.0, air: 0.85),
    // Autumn and winter: a sudden bitter cold under a clear sky.
    (name: "cold_snap", title: "Cold Snap", hours: (8.0, 18.0), clouds: 0.06, cloud_shade: 1.0,
     visibility: 1400.0, light: 1.0, precipitation: 0.0, wind: 4.0, lightning: false, chill: -16.0),
    // Spring and autumn: a howling gale that pushes you about and steals your breath.
    (name: "gale", title: "Gale", hours: (3.0, 6.0), clouds: 0.85, cloud_shade: 0.6,
     visibility: 400.0, light: 0.45, precipitation: 0.2, wind: 24.0, lightning: false, chill: -5.0, air: 0.8),

    // Extreme weather: a harsher version of each kind above. Rarer (small
    // chances in seasons.ron) and shorter.
    // Clear, in summer: a blazing sun and still, hot air.
    (name: "heatwave", title: "Heatwave", hours: (4.0, 8.0), clouds: 0.03, cloud_shade: 1.0,
     visibility: 1000.0, light: 1.15, precipitation: 0.0, wind: 1.0, lightning: false, chill: 14.0, air: 0.95),
    (name: "heavy_overcast", title: "Heavy Overcast", hours: (3.0, 7.0), clouds: 1.0, cloud_shade: 0.55,
     visibility: 600.0, light: 0.3, precipitation: 0.0, wind: 8.0, lightning: false, chill: -3.0),
    // Snow below freezing: "Heavy Snow".
    (name: "downpour", title: "Downpour", hours: (2.5, 5.0), clouds: 1.0, cloud_shade: 0.45,
     visibility: 120.0, light: 0.25, precipitation: 1.0, wind: 10.0, lightning: false, chill: -8.0),
    // Snow below freezing: "Blizzard".
    (name: "tempest", title: "Tempest", hours: (2.5, 4.5), clouds: 1.0, cloud_shade: 0.25,
     visibility: 90.0, light: 0.1, precipitation: 1.0, wind: 20.0, lightning: true, chill: -11.0, air: 0.85),
    (name: "thick_fog", title: "Thick Fog", hours: (2.5, 5.0), clouds: 0.6, cloud_shade: 0.85,
     visibility: 25.0, light: 0.5, precipitation: 0.0, wind: 0.5, lightning: false, chill: -3.0, air: 0.7),
    (name: "deep_freeze", title: "Deep Freeze", hours: (4.0, 8.0), clouds: 0.04, cloud_shade: 1.0,
     visibility: 1400.0, light: 1.0, precipitation: 0.0, wind: 6.0, lightning: false, chill: -28.0),
    (name: "windstorm", title: "Windstorm", hours: (2.5, 4.5), clouds: 0.95, cloud_shade: 0.5,
     visibility: 250.0, light: 0.35, precipitation: 0.3, wind: 34.0, lightning: false, chill: -9.0, air: 0.7),
]
