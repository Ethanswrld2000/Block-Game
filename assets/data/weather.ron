// Weather kinds. The weather changes every `hours` (in-game hours, random
// between the two numbers), picking by the season's chances in seasons.ron,
// and blends over about half a minute.
//   clouds:        share of the sky covered, 0..1
//   cloud_shade:   cloud brightness, 1 = white
//   visibility:    how far you can see in blocks, before biome haze
//   light:         multiplies sunlight
//   precipitation: rain or snow amount, 0..1 (snow where it's below freezing)
//   wind:          cloud and rain drift, blocks per second
//   lightning:     true for thunderstorms
[
    (name: "clear", title: "Clear", hours: (3.0, 8.0), clouds: 0.22, cloud_shade: 1.0,
     visibility: 1400.0, light: 1.0, precipitation: 0.0, wind: 3.0, lightning: false),
    (name: "overcast", title: "Overcast", hours: (2.0, 6.0), clouds: 0.75, cloud_shade: 0.8,
     visibility: 900.0, light: 0.55, precipitation: 0.0, wind: 5.0, lightning: false),
    (name: "rain", title: "Rain", hours: (1.5, 5.0), clouds: 0.9, cloud_shade: 0.6,
     visibility: 260.0, light: 0.35, precipitation: 0.7, wind: 6.0, lightning: false),
    (name: "storm", title: "Thunderstorm", hours: (1.0, 3.0), clouds: 1.0, cloud_shade: 0.4,
     visibility: 170.0, light: 0.2, precipitation: 1.0, wind: 12.0, lightning: true),
    (name: "mist", title: "Mist", hours: (1.0, 4.0), clouds: 0.5, cloud_shade: 0.9,
     visibility: 70.0, light: 0.7, precipitation: 0.0, wind: 1.0, lightning: false),
]
