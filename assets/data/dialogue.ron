                    (text: "What do the clouds say?", tone: "Ask", goto: "clouds"),
                    (text: "What weather is coming?", tone: "Ask", service: "weather"),
                    (text: "Why live up here alone?", tone: "Ask", goto: "alone"),
                    (text: "Come watch the sky from my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Goodbye, Orrin.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["ORRIN_AGAIN_01"],
                choices: [
                    (text: "What do the clouds say?", tone: "Ask", goto: "clouds"),
                    (text: "What weather is coming?", tone: "Ask", service: "weather"),
                    (text: "Why live up here alone?", tone: "Ask", goto: "alone"),
                    (text: "Come watch the sky from my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Goodbye, Orrin.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["ORRIN_HUB_01"],
                choices: [
                    (text: "What do the clouds say?", tone: "Ask", goto: "clouds"),
                    (text: "What weather is coming?", tone: "Ask", service: "weather"),
                    (text: "Why live up here alone?", tone: "Ask", goto: "alone"),
                    (text: "Come watch the sky from my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "clouds": (
                mood: Curious,
                anim: Point,
                say: [
                    "ORRIN_CLOUDS_01",
                    "ORRIN_CLOUDS_02",
                ],
                then: "hub",
            ),
            "alone": (
                mood: Neutral,
                anim: Sit,
                say: [
                    "ORRIN_ALONE_01",
                    "ORRIN_ALONE_02",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["ORRIN_FOLLOW_01"],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["ORRIN_STAY_01"],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
            // Orrin reads the sky: {now}, {clears} and {next} come from the weather.
            "weather": (
                mood: Curious,
                anim: Nod,
                say: ["ORRIN_WEATHER_01", "ORRIN_WEATHER_02"],
                then: "hub",
            ),
            "weather_still": (
                mood: Curious,
                say: ["ORRIN_WEATHER_STILL_01"],
                then: "hub",
            ),
        },
    ),
    // Brindlespheimer, the moldy wizard. He stands at whichever dungeon entrance you are nearest
    // (game::cast), casts the spirit form, names the dungeon's theme and boss and hints at its puzzles.
    // game::delve sets {dungeon}, {floors}, {boss}, {hint} and the flags theme:<name> and cleared_here.
    // Tallow, the peddler of the dungeon floors: old coin for gear (trades.ron `shop`).
    "tallow": (
        start: "greet",
        again: "greet",
        nodes: {
            "greet": (
                mood: Happy,
                say: ["TALLOW_GREET_01", "TALLOW_GREET_02"],
                choices: [
                    (text: "Show me what you have.", tone: "Ask", goto: "trade"),
                    (text: "Goodbye.", end: true),
                ],
            ),
            "trade": (
                mood: Happy,
                say: ["TALLOW_TRADE_01"],
                choices: [(text: "Nothing for now.", end: true)],
            ),
            "trade_done": (
                mood: Happy,
                say: ["TALLOW_TRADE_DONE_01"],
                then: "trade",
            ),
            "trade_short": (
                mood: Neutral,
                say: ["TALLOW_TRADE_SHORT_01"],
                then: "trade",
            ),
        },
    ),
