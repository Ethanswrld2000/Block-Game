                then: "hub",
            ),
            "well": (
                mood: Neutral,
                say: [
                    "I do not feel anything. That is probably fine.",
                    "If you...",
                ],
                then: "hub",
            ),
            "help": (
                mood: Neutral,
                say: [
                    "I can take you out of your body.",
                    "If you...",
