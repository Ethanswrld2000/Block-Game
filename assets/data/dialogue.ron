// Dialogue trees (game::npc::dialogue), one per NPC kind (npcs.ron names it).
//
// A node: `say` = lines spoken one after another (click, Space or E moves on),
// `mood` = Neutral | Happy | Curious | Worried | Sad | Angry | Surprised (face and hands),
// `sets` = flags set on entering, `choices` = your replies, `then` = go straight on
// when there are no replies.
// A reply: `text`, optional `tone` tag, `goto` a node, `end: true` to finish,
// `act: Follow | Stay | Wander` to give an order, `once: true` = gone after picking,
// `needs` / `without` flags to show it, `sets` flags. The flag `following` is on while
// the NPC follows you.
// `start` opens the first talk; `again` opens later ones (flag `met`).
{
    "mossa": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Surprised,
                say: [
                    "Oh! Mind the moss, it bites back. Well, it sulks.",
                    "A dry face in the Great Swamp. That's rare as a straight reed.",
                    "Name's Mossa. Mossa Tarn. I trade, I wander, I talk too much.",
                ],
                choices: [
                    (text: "What do you trade?", tone: "Ask", goto: "trade"),
                    (text: "Tell me about this swamp.", tone: "Ask", goto: "swamp"),
                    (text: "Walk with me a while.", tone: "Kind", goto: "follow"),
                    (text: "I have to go.", end: true),
                ],
            ),
            "again": (
                mood: Happy,
                say: ["Back again! The frogs said you would be. They lie, mostly, but not today."],
                choices: [
                    (text: "What do you trade?", tone: "Ask", goto: "trade"),
                    (text: "Tell me about this swamp.", tone: "Ask", goto: "swamp"),
                    (text: "Walk with me a while.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Go on, wander as you like.", goto: "wander", needs: ["following"]),
                    (text: "Goodbye, Mossa.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["What else is on your mind?"],
                choices: [
                    (text: "What do you trade?", tone: "Ask", goto: "trade"),
                    (text: "Tell me about this swamp.", tone: "Ask", goto: "swamp"),
                    (text: "Walk with me a while.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all for now.", end: true),
                ],
            ),
            "trade": (
                mood: Happy,
                say: [
                    "Reed rope, bog salt, a lens with only one crack in it.",
                    "And stories. Stories are free. The rope is not.",
                ],
                choices: [
                    (text: "A cracked lens? Who'd buy that?", tone: "Blunt", goto: "lens", once: true),
                    (text: "Maybe later.", goto: "hub"),
                ],
            ),
            "lens": (
                mood: Curious,
                say: [
                    "Someone who wants to see two of everything!",
                    "No, truly. Hold it to the stars and the crack splits them. Old charters used that trick.",
                ],
                then: "hub",
            ),
            "swamp": (
                mood: Worried,
                say: [
                    "It's older than the villages on their stilts. Older than the barrows, they say.",
                    "Keep a torch near you after dark. Things walk the reeds that don't like the light.",
                ],
                choices: [
                    (text: "What things?", tone: "Ask", goto: "things"),
                    (text: "I'm not afraid of the dark.", tone: "Bold", goto: "brave"),
                    (text: "Thanks for the warning.", goto: "hub"),
                ],
            ),
            "things": (
                mood: Worried,
                say: [
                    "Cold things. Wights from the barrows, mostly. They remember being people, and it makes them angry.",
                    "Don't go into a barrow at night. Don't go into one in the day either, if you can help it.",
                ],
                choices: [(text: "I'll be careful.", goto: "hub")],
            ),
            "brave": (
                mood: Angry,
                say: ["Then you're a fool, and fools make short stories. Take a torch anyway."],
                choices: [(text: "Fine. A torch.", tone: "Kind", goto: "hub")],
            ),
            "follow": (
                mood: Happy,
                say: ["A walk! My legs were getting bored. Lead on, I'll keep up."],
                choices: [(text: "Let's go.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["Right here? Fine. I'll count the frogs until you're back."],
                choices: [(text: "I won't be long.", act: Stay, end: true)],
            ),
            "wander": (
                mood: Happy,
                say: ["Free as a bog moth. Come find me, I won't go far."],
                choices: [(text: "See you around.", act: Wander, end: true)],
            ),
        },
    ),
    // The guide at every dungeon gate. `act: Spirit` casts the spirit spell:
    // only a spirit passes the veil, and a spirit that falls inside wakes back here.
    "warden": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Curious,
                say: [
                    "Stop there, walker. That doorway is warded, and the ward does not know you.",
                    "I am Ysolde. I keep this gate, and the dead below keep everything else.",
                    "No living body passes the veil. Not with feet, not with a pick. The stones will not break for you.",
                ],
                choices: [
                    (text: "Then how does anyone get in?", tone: "Ask", goto: "how"),
                    (text: "What is down there?", tone: "Ask", goto: "below"),
                    (text: "I'll leave it be.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["Back at the threshold. The halls have shifted their dust since you were here."],
                choices: [
                    (text: "Make me a spirit. I'm going in.", tone: "Ready", goto: "cast"),
                    (text: "Remind me how this works.", tone: "Ask", goto: "how"),
                    (text: "What is down there?", tone: "Ask", goto: "below"),
                    (text: "Not today.", end: true),
                ],
            ),
            "how": (
                mood: Neutral,
                say: [
                    "I can lift your spirit out of your body for a while. Your body stays here with me, safe and sleeping on its feet.",
                    "Your spirit walks the halls. It feels pain, it bleeds light, it can fall.",
                    "If it falls, the ward spits it back out at this door and it settles into your body again. No harm done but pride.",
                ],
                choices: [
                    (text: "And if I win?", tone: "Ask", goto: "win"),
                    (text: "Do it. Make me a spirit.", tone: "Ready", goto: "cast"),
                    (text: "I need to think.", end: true),
                ],
            ),
            "win": (
                mood: Happy,
                say: [
                    "Then you walk back out the way you came, and your spirit comes home on its own.",
                    "Whatever you learned down there, you keep. The halls keep everything else.",
                ],
                choices: [
                    (text: "Make me a spirit.", tone: "Ready", goto: "cast"),
                    (text: "Later.", end: true),
                ],
            ),
            "below": (
                mood: Worried,
                say: [
                    "Long halls. Wide rooms. Things that were people once, and things that never were.",
                    "They guard the deepest hall hardest. Whatever sleeps there wakes for spirits.",
                ],
                choices: [
                    (text: "How do I get in?", tone: "Ask", goto: "how"),
                    (text: "Make me a spirit.", tone: "Ready", goto: "cast"),
                    (text: "I'll leave it be.", end: true),
                ],
            ),
            "cast": (
                mood: Happy,
                say: [
                    "Hold still. Look at your hands, and don't look away.",
                ],
                choices: [
                    (text: "Ready.", act: Spirit, end: true),
                    (text: "Wait, not yet.", goto: "again"),
                ],
            ),
        },
    ),
    // Bram Holloway, the guide. Settles by the ancestral urn (by your bedroll).
    "bram": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Curious,
                say: [
                    "Easy. I'm not here to drag you anywhere.",
                    "Bram Holloway. I know whose daughter you are, and I don't care. The court took enough from me.",
                    "You've got a bedroll and not much else. Let me help with that.",
                ],
                choices: [
                    (text: "What should I do first?", tone: "Ask", goto: "first"),
                    (text: "Why help me?", tone: "Ask", goto: "why"),
                    (text: "Where's worth exploring?", tone: "Ask", goto: "explore"),
                    (text: "Come back to camp with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "See you, Bram.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["Still breathing. Good. What do you need?"],
                choices: [
                    (text: "What should I do first?", tone: "Ask", goto: "first"),
                    (text: "Why help me?", tone: "Ask", goto: "why"),
                    (text: "Where's worth exploring?", tone: "Ask", goto: "explore"),
                    (text: "Come back to camp with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "See you, Bram.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["Anything else?"],
                choices: [
                    (text: "What should I do first?", tone: "Ask", goto: "first"),
                    (text: "Why help me?", tone: "Ask", goto: "why"),
                    (text: "Where's worth exploring?", tone: "Ask", goto: "explore"),
                    (text: "Come back to camp with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "first": (
                mood: Neutral,
                say: [
                    "Sticks and fibre. A camp mat. Then rocks for an axe.",
                    "The urn by your bedroll takes what you give it and makes it into something better. Feed it.",
                ],
                then: "hub",
            ),
            "why": (
                mood: Angry,
                say: [
                    "Because they'd want me not to.",
                    "The court burns what it can't own. You ran from it. That's enough for me.",
                ],
                then: "hub",
            ),
            "explore": (
                mood: Worried,
                say: [
                    "There's a gate of rotten stone not far from here. Mold all over it, a strange man in blue beside it.",
                    "What's under it changes every time you go down. The things at the bottom guard old urns.",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["Lead the way. I'll set myself down by your urn and keep the fire honest."],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["I'll be right here. Don't get yourself killed."],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
        },
    ),
    // Gilm, the mushroom blacksmith, one block tall. Settles by the tool urn.
    "gilm": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Angry,
                say: [
                    "What. You're staring.",
                    "Yes, I'm a mushroom. Yes, I work a forge. Sporrow threw me out for it. Fire frightens them.",
                    "Name's Gilm. If you've come to laugh, laugh fast. I've work.",
                ],
                choices: [
                    (text: "You make tools?", tone: "Ask", goto: "tools"),
                    (text: "Why did Sporrow cast you out?", tone: "Ask", goto: "sporrow"),
                    (text: "Make me something.", tone: "Ask", goto: "commission"),
                    (text: "I have a forge you could use. Come with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Later, Gilm.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["Hm. You again. Brought ore?"],
                choices: [
                    (text: "You make tools?", tone: "Ask", goto: "tools"),
                    (text: "Why did Sporrow cast you out?", tone: "Ask", goto: "sporrow"),
                    (text: "Make me something.", tone: "Ask", goto: "commission"),
                    (text: "I have a forge you could use. Come with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Later, Gilm.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["Anything else?"],
                choices: [
                    (text: "You make tools?", tone: "Ask", goto: "tools"),
                    (text: "Why did Sporrow cast you out?", tone: "Ask", goto: "sporrow"),
                    (text: "Make me something.", tone: "Ask", goto: "commission"),
                    (text: "I have a forge you could use. Come with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "tools": (
                mood: Happy,
                say: [
                    "Better than yours. Better than anyone's on this rock.",
                    "Give me a proper forge and good metal and I'll show you.",
                ],
                then: "hub",
            ),
            "sporrow": (
                mood: Sad,
                say: [
                    "Mold folk and fire don't mix. One spark and a whole village goes up like dry moss.",
                    "I only wanted to make things. They wanted me gone. So I'm gone.",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["A forge? A real one? ...Fine. Show me. If it's a pile of rocks I'm leaving."],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["Fine. I'll stand here like a stump."],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
            // Gilm's commissions: the choices come from services.ron (only tools you can't make yet).
            "commission": (
                mood: Neutral,
                say: ["Bring the metal, I'll make what you can't. What'll it be?"],
                choices: [(text: "Never mind.", goto: "hub")],
            ),
            "commission_done": (
                mood: Happy,
                say: ["There. One {made}. Better than you'd ever manage."],
                then: "hub",
            ),
            "commission_short": (
                mood: Angry,
                say: ["You're short. I need {missing} more. I don't work for nothing."],
                then: "hub",
            ),
        },
    ),
    // Wren Calloway, the barterer with her own flying machine. Settles by the vehicle urn.
    "wren": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Happy,
                say: [
                    "Oh, a customer! Don't mind the oil, she leaks when she's happy.",
                    "Wren Calloway. I buy, I sell, I fly. Mostly I haggle.",
                    "Where have I been? Here and there. Mostly there.",
                ],
                choices: [
                    (text: "What do you sell?", tone: "Ask", goto: "sell"),
                    (text: "Let's trade.", tone: "Ask", goto: "trade"),
                    (text: "Where do you fly?", tone: "Ask", goto: "fly"),
                    (text: "Land by my camp. There's room for a machine.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Safe skies, Wren.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["There you are! Got coin, or got stories? I take both."],
                choices: [
                    (text: "What do you sell?", tone: "Ask", goto: "sell"),
                    (text: "Let's trade.", tone: "Ask", goto: "trade"),
                    (text: "Where do you fly?", tone: "Ask", goto: "fly"),
                    (text: "Land by my camp. There's room for a machine.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Safe skies, Wren.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["Anything else?"],
                choices: [
                    (text: "What do you sell?", tone: "Ask", goto: "sell"),
                    (text: "Let's trade.", tone: "Ask", goto: "trade"),
                    (text: "Where do you fly?", tone: "Ask", goto: "fly"),
                    (text: "Land by my camp. There's room for a machine.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "sell": (
                mood: Happy,
                say: [
                    "Today? Rope, bolts, a fan blade that's only a little bent.",
                    "Tomorrow, who knows. Depends where the wind takes me.",
                ],
                then: "hub",
            ),
            "fly": (
                mood: Curious,
                say: [
                    "Everywhere and nowhere you'd find on a map.",
                    "A trader who tells you where her stock comes from isn't a trader for long.",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["A spot for my machine and a steady customer? Done. Show me where."],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["I'll wait. Not long, mind. Time's coin."],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
            // Wren's trades: the choices come from trades.ron, a few each visit.
            "trade": (
                mood: Happy,
                say: ["Today's stock. Take it or leave it. Mostly take it."],
                choices: [(text: "Not today.", goto: "hub")],
            ),
            "trade_done": (
                mood: Happy,
                say: ["Pleasure doing business. {got}, as promised."],
                then: "trade",
            ),
            "trade_short": (
                mood: Neutral,
                say: ["You're short {missing}. No credit, sorry. Not even for you."],
                then: "trade",
            ),
        },
    ),
    // Liora Vance, once a courtesan of the court. Sews clothes and armor. Settles by the gear urn.
    "liora": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Curious,
                say: [
                    "Well. I know that face. Half the court would pay a fortune to see it again.",
                    "Don't worry, I'm not one of them. Not any more. Liora Vance. I bought my way out and left in the night.",
                    "Same as you, I think.",
                ],
                choices: [
                    (text: "What did you do at court?", tone: "Ask", goto: "court"),
                    (text: "Can you sew?", tone: "Ask", goto: "sew"),
                    (text: "Could you make me something to wear?", tone: "Ask", goto: "commission"),
                    (text: "You could stay at my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Goodbye, Liora.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["Your Highness. Joking. Mostly."],
                choices: [
                    (text: "What did you do at court?", tone: "Ask", goto: "court"),
                    (text: "Can you sew?", tone: "Ask", goto: "sew"),
                    (text: "Could you make me something to wear?", tone: "Ask", goto: "commission"),
                    (text: "You could stay at my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Goodbye, Liora.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["Anything else?"],
                choices: [
                    (text: "What did you do at court?", tone: "Ask", goto: "court"),
                    (text: "Can you sew?", tone: "Ask", goto: "sew"),
                    (text: "Could you make me something to wear?", tone: "Ask", goto: "commission"),
                    (text: "You could stay at my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "court": (
                mood: Neutral,
                say: [
                    "Listened. People tell a courtesan everything, and forget she was in the room.",
                    "I learned which lords owed what, and to whom. It bought my freedom.",
                ],
                choices: [
                    (text: "Who holds the court now?", tone: "Ask", goto: "court_lords"),
                    (text: "Do they talk about me?", tone: "Ask", goto: "court_heir"),
                    (text: "Something else.", goto: "hub"),
                ],
            ),
            "sew": (
                mood: Happy,
                say: [
                    "Can I sew? I dressed half the court and mended the other half.",
                    "Give me cloth and hide and a table, and you'll look like someone worth hunting.",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["With a runaway heir and a pile of urns? How could I refuse. Lead on."],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["I'll wait. Don't keep a lady waiting too long."],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
            "court_lords": (
                mood: Worried,
                say: [
                    "The regent, in name. In truth, whoever paid him last.",
                    "Three houses circle the throne like crows round a fence post. None of them trusts the others, so none of them moves.",
                    "It's held for years like that. It won't hold forever.",
                ],
                then: "court",
            ),
            "court_heir": (
                mood: Curious,
                say: [
                    "Of course they do. A missing heir is the best gossip there is.",
                    "Some say you're dead. Some say you're mad. The ones who pay best ask where you are.",
                    "I never tell them. A good courtesan knows what not to sell.",
                ],
                then: "court",
            ),
            // Liora's tailoring: the choices come from services.ron.
            "commission": (
                mood: Happy,
                say: ["Bring me the cloth and I'll do the rest. What would you like?"],
                choices: [(text: "Never mind.", goto: "hub")],
            ),
            "commission_done": (
                mood: Happy,
                say: ["There. A {made}. Try not to bleed on it."],
                then: "hub",
            ),
            "commission_short": (
                mood: Neutral,
                say: ["I can't sew from thin air, darling. I need {missing} more."],
                then: "hub",
            ),
        },
    ),
    // Messler, a rat one block tall and 130 years old, made to think by a court wizard. Settles by the hearth urn.
    "messler": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Angry,
                say: [
                    "Don't step on me. People always step on me. One hundred and thirty years of being stepped on.",
                    "Messler. A wizard of the court made me think, then made me wish I couldn't.",
                    "Are you going to eat that? You look like you burn things.",
                ],
                choices: [
                    (text: "Who made you like this?", tone: "Ask", goto: "wizard"),
                    (text: "Can you cook?", tone: "Ask", goto: "cook"),
                    (text: "Here, have something to eat.", tone: "Kind", service: "feed"),
                    (text: "There's a cooking fire at my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Bye, Messler.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["Oh. You. Did you bring food, or just your face?"],
                choices: [
                    (text: "Who made you like this?", tone: "Ask", goto: "wizard"),
                    (text: "Can you cook?", tone: "Ask", goto: "cook"),
                    (text: "Here, have something to eat.", tone: "Kind", service: "feed"),
                    (text: "There's a cooking fire at my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Bye, Messler.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["Anything else?"],
                choices: [
                    (text: "Who made you like this?", tone: "Ask", goto: "wizard"),
                    (text: "Can you cook?", tone: "Ask", goto: "cook"),
                    (text: "Here, have something to eat.", tone: "Kind", service: "feed"),
                    (text: "There's a cooking fire at my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "wizard": (
                mood: Sad,
                say: [
                    "A court wizard with soft hands and a hard heart. I was his experiment. Then his footstool.",
                    "I've no idea if I can die. I've stopped asking.",
                ],
                then: "hub",
            ),
            "cook": (
                mood: Happy,
                say: [
                    "Better than you, and I've only got paws.",
                    "Feed me and I might even tell you how.",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["A fire and someone to feed me? Lead on. Mind the tail."],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["Fine. I'll sit here and starve politely."],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
            // Feeding Messler (services.ron `messler_teaches`).
            "fed": (
                mood: Happy,
                say: ["Mm. Fine. Fine! Here's one for you, then: {recipe}.", "Pot, fire, stir. Don't burn it."],
                then: "hub",
            ),
            "fed_all": (
                mood: Happy,
                say: ["Mm. I've taught you all I'll teach. Thanks all the same."],
                then: "hub",
            ),
            "no_food": (
                mood: Angry,
                say: ["With what? You've nothing to eat on you. Cruel."],
                then: "hub",
            ),
        },
    ),
    // Orrin Vale, the weather keeper in the mountain castle. Settles by the star urn.
    "orrin": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Curious,
                say: [
                    "Shh. The clouds were telling me something.",
                    "Ah, it's gone now. Never mind. I'm Orrin. I watch the sky. Someone ought to.",
                    "You walk like someone with the wind at her back. Running, are you?",
                ],
                choices: [
                    (text: "What do the clouds say?", tone: "Ask", goto: "clouds"),
                    (text: "What weather is coming?", tone: "Ask", service: "weather"),
                    (text: "Why live up here alone?", tone: "Ask", goto: "alone"),
                    (text: "Come watch the sky from my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Goodbye, Orrin.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["The sky's been talking about you."],
                choices: [
                    (text: "What do the clouds say?", tone: "Ask", goto: "clouds"),
                    (text: "What weather is coming?", tone: "Ask", service: "weather"),
                    (text: "Why live up here alone?", tone: "Ask", goto: "alone"),
                    (text: "Come watch the sky from my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Goodbye, Orrin.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["Anything else?"],
                choices: [
                    (text: "What do the clouds say?", tone: "Ask", goto: "clouds"),
                    (text: "What weather is coming?", tone: "Ask", service: "weather"),
                    (text: "Why live up here alone?", tone: "Ask", goto: "alone"),
                    (text: "Come watch the sky from my camp.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all.", end: true),
                ],
            ),
            "clouds": (
                mood: Curious,
                say: [
                    "Mostly, rain. Sometimes, more rain.",
                    "But listen long enough and they tell you what's coming, and when it'll pass.",
                ],
                then: "hub",
            ),
            "alone": (
                mood: Neutral,
                say: [
                    "The castle was empty. So was I. We suit each other.",
                    "Up here there's nothing between me and the sky.",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                say: ["A new sky to read. Why not. I'll follow."],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["I'll stay and count the clouds."],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
            // Orrin reads the sky: {now}, {clears} and {next} come from the weather.
            "weather": (
                mood: Curious,
                say: ["{now} now. It clears {clears}.", "After that, {next}."],
                then: "hub",
            ),
            "weather_still": (
                mood: Curious,
                say: ["{now}, and it's staying. I can't see an end to it."],
                then: "hub",
            ),
        },
    ),
    // Brindlespheimer, the moldy wizard at the Rotting Gate. Blank face, slow speech; never follows.
    "brindlespheimer": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Neutral,
                say: [
                    "Hello.",
                    "I am Brindlespheimer. I think.",
                    "I do not remember how I came to this island. The mold remembers. It does not say.",
                    "Before you go down, I can take you out of your body.",
                ],
                choices: [
                    (text: "What is this gate?", tone: "Ask", goto: "gate"),
                    (text: "Are you all right?", tone: "Ask", goto: "well"),
                    (text: "Take me out of my body.", tone: "Ask", goto: "help"),
                    (text: "Goodbye.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["Hello again.", "I can take you out of your body. Before you go down."],
                choices: [
                    (text: "What is this gate?", tone: "Ask", goto: "gate"),
                    (text: "Are you all right?", tone: "Ask", goto: "well"),
                    (text: "Take me out of my body.", tone: "Ask", goto: "help"),
                    (text: "Goodbye.", end: true),
                ],
            ),
            "hub": (
