            "explore": (
                mood: Worried,
                anim: Point,
                say: [
                    "BRAM_EXPLORE_01",
                    "BRAM_EXPLORE_02",
                ],
                then: "hub",
            ),
            "follow": (
                mood: Happy,
                anim: Nod,
                say: ["BRAM_FOLLOW_01"],
                choices: [(text: "Come on, then.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["BRAM_STAY_01"],
                choices: [(text: "I'll be back.", act: Stay, end: true)],
            ),
        },
    ),
