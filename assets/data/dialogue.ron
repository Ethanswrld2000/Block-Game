                choices: [
                    (text: "What should I do first?", tone: "Ask", goto: "first"),
                    (text: "Why help me?", tone: "Ask", goto: "why"),
                    (text: "Where's worth exploring?", tone: "Ask", goto: "explore"),
                    (text: "Come back to camp with me.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "See you, Bram.", end: true),
