// Dialogue trees (game::npc::dialogue), one per NPC kind (npcs.ron names it).
//
// A node: `say` = lines spoken one after another (click, Space or E moves on),
// `mood` = Neutral | Happy | Curious | Worried | Sad | Angry | Surprised (face and hands),
// `anim` = a body animation as the node starts: Wave | Nod | HeadShake | Shrug | Bow | Point | Cheer
// play once; Sit (on the ground) | Think (hand to chin) are held until a later node's `anim`
// (Stand gets up) or the talk ends,
// `sets` = flags set on entering, `choices` = your replies, `then` = go straight on
// when there are no replies.
// A reply: `text`, optional `tone` tag, `goto` a node, `end: true` to finish,
// `act: Follow | Stay | Wander` to give an order, `once: true` = gone after picking,
// `needs` / `without` flags to show it, `sets` flags. The flag `following` is on while
// the NPC follows you.
// `start` opens the first talk; `again` opens later ones (flag `met`).
{
    "mossa": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Surprised,
                anim: Wave,
                say: [
                    "MOSSA_GREET_01",
                    "MOSSA_GREET_02",
                    "MOSSA_GREET_03",
                ],
                choices: [
                    (text: "What do you trade?", tone: "Ask", goto: "trade"),
                    (text: "Tell me about this swamp.", tone: "Ask", goto: "swamp"),
                    (text: "Walk with me a while.", tone: "Kind", goto: "follow"),
                    (text: "I have to go.", end: true),
                ],
            ),
            "again": (
                mood: Happy,
                say: ["MOSSA_AGAIN_01"],
                choices: [
                    (text: "What do you trade?", tone: "Ask", goto: "trade"),
                    (text: "Tell me about this swamp.", tone: "Ask", goto: "swamp"),
                    (text: "Walk with me a while.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "Go on, wander as you like.", goto: "wander", needs: ["following"]),
                    (text: "Goodbye, Mossa.", end: true),
                ],
            ),
            "hub": (
                mood: Neutral,
                say: ["MOSSA_HUB_01"],
                choices: [
                    (text: "What do you trade?", tone: "Ask", goto: "trade"),
                    (text: "Tell me about this swamp.", tone: "Ask", goto: "swamp"),
                    (text: "Walk with me a while.", tone: "Kind", goto: "follow", without: ["following"]),
                    (text: "Wait here for me.", goto: "stay", needs: ["following"]),
                    (text: "That's all for now.", end: true),
                ],
            ),
            "trade": (
                mood: Happy,
                say: [
                    "MOSSA_TRADE_01",
                    "MOSSA_TRADE_02",
                ],
                choices: [
                    (text: "A cracked lens? Who'd buy that?", tone: "Blunt", goto: "lens", once: true),
                    (text: "Maybe later.", goto: "hub"),
                ],
            ),
            "lens": (
                mood: Curious,
                say: [
                    "MOSSA_LENS_01",
                    "MOSSA_LENS_02",
                ],
                then: "hub",
            ),
            "swamp": (
                mood: Worried,
                anim: Think,
                say: [
                    "MOSSA_SWAMP_01",
                    "MOSSA_SWAMP_02",
                ],
                choices: [
                    (text: "What things?", tone: "Ask", goto: "things"),
                    (text: "I'm not afraid of the dark.", tone: "Bold", goto: "brave"),
                    (text: "Thanks for the warning.", goto: "hub"),
                ],
            ),
            "things": (
                mood: Worried,
                say: [
                    "MOSSA_THINGS_01",
                    "MOSSA_THINGS_02",
                ],
                choices: [(text: "I'll be careful.", goto: "hub")],
            ),
            "brave": (
                mood: Angry,
                say: ["MOSSA_BRAVE_01"],
                choices: [(text: "Fine. A torch.", tone: "Kind", goto: "hub")],
            ),
            "follow": (
                mood: Happy,
                anim: Cheer,
                say: ["MOSSA_FOLLOW_01"],
                choices: [(text: "Let's go.", act: Follow, end: true)],
            ),
            "stay": (
                mood: Neutral,
                say: ["MOSSA_STAY_01"],
                choices: [(text: "I won't be long.", act: Stay, end: true)],
            ),
            "wander": (
                mood: Happy,
                say: ["MOSSA_WANDER_01"],
                choices: [(text: "See you around.", act: Wander, end: true)],
            ),
        },
    ),
    // The guide at every dungeon gate. `act: Spirit` casts the spirit spell:
    // only a spirit passes the veil, and a spirit that falls inside wakes back here.
    "warden": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Curious,
                anim: Point,
                say: [
                    "WARDEN_GREET_01",
                    "WARDEN_GREET_02",
                    "WARDEN_GREET_03",
                ],
                choices: [
                    (text: "Then how does anyone get in?", tone: "Ask", goto: "how"),
                    (text: "What is down there?", tone: "Ask", goto: "below"),
                    (text: "I'll leave it be.", end: true),
                ],
            ),
            "again": (
                mood: Neutral,
                say: ["WARDEN_AGAIN_01"],
                choices: [
                    (text: "Make me a spirit. I'm going in.", tone: "Ready", goto: "cast"),
                    (text: "Remind me how this works.", tone: "Ask", goto: "how"),
                    (text: "What is down there?", tone: "Ask", goto: "below"),
                    (text: "Not today.", end: true),
                ],
            ),
            "how": (
                mood: Neutral,
                say: [
                    "WARDEN_HOW_01",
                    "WARDEN_HOW_02",
                    "WARDEN_HOW_03",
                ],
                choices: [
                    (text: "And if I win?", tone: "Ask", goto: "win"),
                    (text: "Do it. Make me a spirit.", tone: "Ready", goto: "cast"),
                    (text: "I need to think.", end: true),
                ],
            ),
            "win": (
                mood: Happy,
                say: [
                    "WARDEN_WIN_01",
                    "WARDEN_WIN_02",
                ],
                choices: [
                    (text: "Make me a spirit.", tone: "Ready", goto: "cast"),
                    (text: "Later.", end: true),
                ],
            ),
            "below": (
                mood: Worried,
                anim: Think,
                say: [
                    "WARDEN_BELOW_01",
                    "WARDEN_BELOW_02",
                ],
                choices: [
                    (text: "How do I get in?", tone: "Ask", goto: "how"),
                    (text: "Make me a spirit.", tone: "Ready", goto: "cast"),
                    (text: "I'll leave it be.", end: true),
                ],
            ),
            "cast": (
                mood: Happy,
                say: [
                    "WARDEN_CAST_01",
                ],
                choices: [
                    (text: "Ready.", act: Spirit, end: true),
                    (text: "Wait, not yet.", goto: "again"),
                ],
            ),
        },
    ),
    // Bram Holloway, the guide. Settles by the ancestral urn (by your bedroll).
    "bram": (
        start: "greet",
        again: "again",
        nodes: {
            "greet": (
                mood: Curious,
                anim: Shrug,
                say: [
