// The getting-started guide (game::guide). After the opening (C01 sets the flag `guide_on`),
// the journal (J) walks you through these steps one at a time, top to bottom: the step under
// way shows with what to do, finished ones are ticked off. Each step is done once its goal
// holds (the story flag `guide:<id>` is set, so story beats can wait on it).
//
//   id, title, text: the journal entry
//   goal:
//     Have([("stick", 5), ("small_rock", 2)])  in your pockets; "log|swamp_log" counts any of them
//     Camp                                     your bedroll is laid out (B)
//     Step("camp_mat")                          an urn step is done
//     Made("rough_axe")                         made at a bench
//     Home                                      you stand in a proper home: a closed room with a door
//                                               in its walls and a torch (or any light) inside
//     Urn                                       you have an urn of your own (carried or set down)
//     UrnPlaced                                 you have set one down
//     Slept                                     you have slept (Z by your bed, at night)
//   marks: waypoints to the nearest of these blocks in the loaded world, until you have enough:
//     (name: "Sticks", blocks: ["twig_*", "dry_brush"], until: ("stick", 5)); `*` ends a name prefix
//   cutscene: played when the step comes up (cutscenes.ron): Bram walks over and says what's next
//
// Day one: Bram finds you as you wake (C01), hands you the Ancestral Urn and walks you through
// making camp. Each step after the first opens with him talking (G_*); the last is sleeping
// through the first night. Until the bed step is done, Z won't sleep (`survival::camp`).
(
    steps: [
        (
            id: "gather",
            title: "Sticks and stones",
            text: "Bram wants sticks and stones first. Right click twigs on tree trunks to snap them off, and pebbles on the ground to pick them up. The marks at the top of the screen point to the nearest ones.",
            goal: Have([("stick", 5), ("small_rock", 2)]),
            marks: [
                (name: "Sticks", blocks: ["twig_*", "dry_brush"], until: ("stick", 5)),
                (name: "Stones", blocks: ["pebble"], until: ("small_rock", 2)),
            ],
        ),
        (
            id: "camp",
            title: "Set up camp",
            text: "Find a flat, open spot and press B to lay out your bedroll. The urn Bram gave you stands beside it.",
            goal: Camp,
            cutscene: "G_camp",
        ),
        (
            id: "fiber",
            title: "Plant fiber",
            text: "Bram says the urn wants plant fiber for a bed. Pull up tall grass and reeds until you have 4.",
            goal: Have([("plant_fiber", 4)]),
            marks: [
                (name: "Grass", blocks: ["tall_grass", "reeds", "fern"], until: ("plant_fiber", 4)),
            ],
            cutscene: "G_fiber",
        ),
        (
            id: "bed",
            title: "Make your bed",
            text: "Hold sticks or plant fiber and right click the urn to put them in (Shift puts in all it wants). 4 sticks and 4 fiber weave the Camp Mat: your bed.",
            goal: Step("camp_mat"),
            cutscene: "G_bed",
        ),
        (
            id: "sleep",
            title: "Sleep",
            text: "Wait for night to fall, then stand by your bed and press Z to sleep through it.",
            goal: Slept,
            cutscene: "G_sleep",
        ),
    ],
)
