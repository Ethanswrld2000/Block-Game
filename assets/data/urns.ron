// Urns: every station grows around its own urn. You put things into an urn to
// finish its steps; each finished step places a station beside it, upgrades
// one, teaches new recipes, or gives you the urn of another station.
//
// urns:
//   name:    id (the save and other urns refer to it)
//   title:   the urn's name on screen
//   station: the station it grows ("Sleeping Station")
//   item:    the item you carry and set down to start it (none: the ancestral
//            urn stands by your bedroll from the start)
//   color:   its clay and the glow of its marks, (r, g, b) 0-1
//   how:     how a player first gets it (shown in the urn's tree)
//   steps:   what you fill, in the order the tree shows them
//     name:  id, unique across all urns (benches.ron `unlock`s and code look for it)
//     tier:  1 near home, 2 a trip out (caves, hides, iron), 3 far finds
//            (sky islands, barrow relics)
//     gives: Station("kind") places that station by the urn;
//            Upgrade improves the station or camp (code asks `has("name")`);
//            Recipes teaches the benches.ron recipes that name it in `unlock`;
//            Urn("name") gives you that urn to carry and set down.
//     needs: { "item": count } - all of it goes into the urn, a bit at a time
//     after: steps (of this urn) that must be done first
//     desc:  one line for the tree and the planning sheet
//     later: true where what it does isn't in the game yet (the step still
//            fills and places its model, so the tree can be played through)
(
    urns: [
        (
            name: "ancestral", title: "Ancestral Urn", station: "Sleeping Station",
            color: (0.58, 0.36, 0.24),
            how: "Stands by your bedroll once you lay it out, and moves with it.",
            steps: [
                (name: "camp_mat", title: "Camp Mat", tier: 1, gives: Station("camp_mat"),
                 needs: { "stick": 4, "plant_fiber": 4 },
                 desc: "A woven mat with a knapping stone. Lash rocks to a stick for your first axe."),
                (name: "block_crafter", title: "Block Crafter", tier: 1, gives: Station("block_crafter"), after: ["camp_mat"],
                 needs: { "raw_wood": 4, "stick": 4 },
                 desc: "A splitting block and a saw: raw wood into wood slats, your first building block."),
                (name: "tool_urn", title: "Tool Urn", tier: 1, gives: Urn("tool"), after: ["camp_mat"],
                 needs: { "small_rock": 6, "stick": 6, "cordage": 1 },
                 desc: "Set it down anywhere to start the Tool Station."),
                (name: "bedframe", title: "Bedframe", tier: 1, gives: Upgrade, after: ["tool_urn"],
                 needs: { "planks": 6, "cordage": 2 },
                 desc: "Lifts the bedroll off the wet ground: deeper sleep, warmer mornings."),
                (name: "personal_storage", title: "Personal Storage", tier: 2, gives: Station("personal_storage"), after: ["bedframe"],
                 needs: { "planks": 8, "hide": 1, "mold_bloom": 3 },
                 desc: "A trunk at the foot of the bed. It packs up with your camp."),
                (name: "portable_bedroll", title: "Portable Bedroll", tier: 2, gives: Recipes, after: ["bedframe"],
                 needs: { "hide": 2, "cordage": 3, "mold_bloom": 3 },
                 desc: "The camp mat learns to roll a spare bedroll, to sleep away from home."),
                (name: "double_bed", title: "Double-wide Bed", tier: 2, gives: Upgrade, after: ["bedframe"],
                 needs: { "planks": 10, "fur": 2, "hide": 2, "mold_bloom": 3 },
                 desc: "Room for two, and fur to sleep warm through winter."),
                (name: "storage_shelf", title: "Extra Shelf", tier: 3, gives: Upgrade, after: ["personal_storage"],
                 needs: { "planks": 10, "raw_iron": 2, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "Personal storage gets another row."),
                (name: "portable_tent", title: "Portable Tent", tier: 3, gives: Recipes, after: ["portable_bedroll"],
                 needs: { "hide": 4, "stick": 8, "cordage": 4, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "The camp mat learns to make a tent: shelter from rain and wind on the road."),
                (name: "golem_urn", title: "Golem Urn", tier: 3, gives: Urn("golem"), after: ["tool_urn"],
                 needs: { "raw_iron": 8, "spirit_ember": 4, "skystone": 6, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "Set it down to start the Golem Station."),
            ],
        ),
        (
            name: "tool", title: "Tool Urn", station: "Tool Station", item: Some("tool_urn"),
            color: (0.55, 0.56, 0.6),
            how: "The ancestral urn gives it once the camp mat is built.",
            steps: [
                (name: "tool_bench", title: "Tool Bench", tier: 1, gives: Station("tool_bench"),
                 needs: { "stick": 4, "small_rock": 4 },
                 desc: "A handle groove and a strike stone: rock picks and shovels."),
                (name: "improved_tool_bench", title: "Improved Tool Bench", tier: 2, gives: Recipes, after: ["tool_bench"],
                 needs: { "planks": 6, "cordage": 4, "flint": 3, "mold_bloom": 3 },
                 desc: "More crafting options: the stone axe and the flint spear."),
                (name: "iron_anvil", title: "Iron Anvil", tier: 2, gives: Station("iron_anvil"), after: ["improved_tool_bench"],
                 needs: { "raw_iron": 10, "cobblestone": 12, "coal": 6, "mold_bloom": 3 },
                 desc: "Hammer iron into tools and fittings."),
                (name: "steel_anvil", title: "Steel Anvil", tier: 3, gives: Recipes, after: ["iron_anvil"],
                 needs: { "raw_iron": 20, "coal": 16, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "The anvil takes steel: coal in the flux tray hammers steel picks and axes."),
                (name: "alchemical_anvil", title: "Alchemical Anvil", tier: 3, gives: Recipes, after: ["steel_anvil"],
                 needs: { "spirit_ember": 6, "skystone": 8, "old_coin": 2, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "Etched with spirit marks: spirit embers in the flux tray make spirit-etched tools."),
            ],
        ),
        (
            name: "carpentry", title: "Carpentry Urn", station: "Carpentry Station", item: Some("carpentry_urn"),
            color: (0.62, 0.48, 0.3),
            how: "The Rotting King drops it when the Rotting Gate (the first dungeon) is cleared, once per world.",
            steps: [
                (name: "carpentry_bench", title: "Carpentry Bench", tier: 1, gives: Station("carpentry_bench"),
                 needs: { "raw_wood": 8, "flint": 2 },
                 desc: "Saw logs into planks and planks into sticks; build chests."),
                (name: "carpentry_table", title: "Carpentry Table", tier: 1, gives: Station("carpentry_table"), after: ["carpentry_bench"],
                 needs: { "planks": 8, "stick": 4, "cordage": 2 },
                 desc: "Join wood into building supplies: floorboards, timber and wattle walls, thatch."),
                (name: "joiners_table", title: "Joiner's Table", tier: 1, gives: Station("joiners_table"), after: ["carpentry_table"],
                 needs: { "planks": 10, "stick": 6, "cordage": 2 },
                 desc: "Furniture: chairs and tables, joined with pegs."),
                (name: "door_frame", title: "Door Frame", tier: 2, gives: Station("door_frame"), after: ["joiners_table"],
                 needs: { "planks": 12, "raw_iron": 2, "stick": 4, "mold_bloom": 3 },
                 desc: "A frame to hang doors in: wooden doors for your rooms."),
                (name: "glass_kiln", title: "Glass Kiln", tier: 2, gives: Station("glass_kiln"), after: ["carpentry_bench"],
                 needs: { "clay": 10, "cobblestone": 8, "sand": 6, "mold_bloom": 3 },
                 desc: "A hot clay kiln: melt sand into glass, and glass into windows."),
            ],
        ),
        (
            name: "vehicle", title: "Vehicle Urn", station: "Vehicle Station", item: Some("vehicle_urn"),
            color: (0.42, 0.5, 0.56),
            how: "The Pit Foreman drops it when the Collapsed Mine (the fourth dungeon) is cleared, once per world.",
            steps: [
                (name: "machination_table", title: "Machination Table", tier: 1, gives: Station("machination_table"),
                 needs: { "planks": 12, "raw_iron": 6, "cordage": 4 },
                 desc: "Gears, a slipway and a drive wheel: build machines. First of them, an airship to leave the island."),
            ],
        ),
        (
            name: "gear", title: "Gear Urn", station: "Gear Station", item: Some("gear_urn"),
            color: (0.5, 0.26, 0.3),
            how: "The Drowned Abbess drops it when the Flooded Crypt (the second dungeon) is cleared, once per world.",
            steps: [
                (name: "sewing_table", title: "Sewing Table", tier: 1, gives: Station("sewing_table"),
                 needs: { "planks": 6, "cordage": 4, "plant_fiber": 6 },
                 desc: "Needle, thread and a cutting table: hats, cloaks, boots, leggings and coats."),
                (name: "armor_stand", title: "Armor Stand", tier: 1, gives: Station("armor_stand"), after: ["sewing_table"],
                 needs: { "planks": 4, "hide": 2, "cordage": 2 },
                 desc: "Fit armor on the stand: bark and leather."),
                (name: "bladesmith_bench", title: "Bladesmith Bench", tier: 2, gives: Station("bladesmith_bench"), after: ["armor_stand"],
                 needs: { "raw_iron": 8, "coal": 4, "planks": 4, "mold_bloom": 3 },
                 desc: "An anvil for blades: daggers and swords."),
                (name: "sharpening_stone", title: "Sharpening Stone", tier: 2, gives: Station("sharpening_stone"), after: ["sewing_table"],
                 needs: { "cobblestone": 8, "sand": 6, "stick": 2, "mold_bloom": 3 },
                 desc: "Hone an edge: a sharpened tool works faster for ten minutes."),
                (name: "rapier", title: "Rapier Forms", tier: 2, gives: Recipes, after: ["bladesmith_bench"],
                 needs: { "raw_iron": 6, "coal": 4, "cordage": 2, "mold_bloom": 3 },
                 desc: "The bladesmith bench learns the rapier: long, thin and quick."),
                (name: "metal_armor", title: "Metal Armor", tier: 3, gives: Recipes, after: ["armor_stand", "bladesmith_bench"],
                 needs: { "raw_iron": 16, "coal": 8, "hide": 4, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "The armor stand learns iron: an iron helm and iron mail."),
                (name: "gunsmith_bench", title: "Gunsmith Bench", tier: 3, gives: Station("gunsmith_bench"), after: ["bladesmith_bench"],
                 needs: { "raw_iron": 20, "coal": 10, "planks": 6, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "Barrels and stocks: a makeshift pistol, a rifle and iron shot to fire from them."),
            ],
        ),
        (
            name: "hearth", title: "Hearth Urn", station: "Cooking Station", item: Some("hearth_urn"),
            color: (0.72, 0.3, 0.2),
            how: "The Root Mother drops it when the Root-choked Hall (the third dungeon) is cleared, once per world.",
            steps: [
                (name: "cooking_pot", title: "Cooking Pot", tier: 1, gives: Station("cooking_pot"),
                 needs: { "clay": 6, "stick": 6, "small_rock": 4 },
                 desc: "A clay pot on a fire: put food in, fuel under it, and stir. Roasts, broths and stews."),
                (name: "cutting_board", title: "Cutting Board", tier: 1, gives: Station("cutting_board"), after: ["cooking_pot"],
                 needs: { "planks": 4, "flint": 2 },
                 desc: "Cut meat, reeds and fish with the knife first: more and better portions."),
                (name: "smoking_rack", title: "Smoking Rack", tier: 2, gives: Station("smoking_rack"), after: ["cooking_pot"],
                 needs: { "stick": 12, "cordage": 4, "peat": 6, "mold_bloom": 3 },
                 desc: "Peat smoke dries meat and fish so it keeps on long trips: cured meat, smoked fish."),
                (name: "herb_rack", title: "Herb Rack", tier: 2, gives: Recipes, after: ["cutting_board"],
                 needs: { "swamp_reed": 8, "marsh_berries": 6, "cordage": 2, "mold_bloom": 3 },
                 desc: "Seasoning lifts a meal a food tier: the pot learns seasoned stew and the feast platter."),
                (name: "stone_fridge", title: "Stone Fridge", tier: 3, gives: Station("stone_fridge"), after: ["cutting_board"],
                 needs: { "cobblestone": 16, "clay": 8, "moss": 8, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "A cold stone box lined with moss: a cupboard for your food."),
            ],
        ),
        (
            name: "star", title: "Star Urn", station: "Astronomy Station", item: Some("star_urn"),
            color: (0.28, 0.32, 0.62),
            how: "Once the vault under the mountain castle is cleared, it stands at the top of the castle tower, by Orrin Vale.",
            steps: [
                (name: "telescope", title: "Telescope", tier: 1, gives: Station("telescope"),
                 needs: { "planks": 6, "flint": 4, "raw_iron": 2 },
                 desc: "Look through it at night to find constellations."),
                (name: "magical_lens", title: "Magical Lens", tier: 2, gives: Station("magical_lens"), after: ["telescope"],
                 needs: { "skystone": 6, "cloud_moss": 4, "mold_bloom": 3 },
                 desc: "Shows the flux in things: what an item is made of, and which draughts it goes into."),
                (name: "improved_telescope", title: "Improved Telescope", tier: 2, gives: Upgrade, after: ["telescope"],
                 needs: { "raw_iron": 6, "planks": 6, "skystone": 2, "mold_bloom": 3 },
                 desc: "A longer tube: fainter stars, more constellations."),
                (name: "cauldron", title: "Cauldron", tier: 2, gives: Station("cauldron"), after: ["magical_lens"],
                 needs: { "raw_iron": 8, "clay": 6, "coal": 4, "mold_bloom": 3 },
                 desc: "Brews draughts from what the lens has shown you: levitation, light, warmth, focus."),
                (name: "diamond_lens", title: "Diamond Lens", tier: 3, gives: Upgrade, after: ["improved_telescope", "magical_lens"],
                 needs: { "skystone": 12, "spirit_ember": 6, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "The telescope sees the hidden constellations."),
                (name: "steel_cauldron", title: "Steel Cauldron", tier: 3, gives: Recipes, after: ["cauldron"],
                 needs: { "raw_iron": 16, "coal": 10, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "Bigger brews: every draught comes out two at a time."),
            ],
        ),
        (
            name: "golem", title: "Golem Urn", station: "Golem Station", item: Some("golem_urn"),
            color: (0.42, 0.5, 0.4),
            how: "The ancestral urn gives it last, for sky-island stone.",
            steps: [
                (name: "golem_frame", title: "Golem Frame", tier: 1, gives: Station("golem_frame"),
                 needs: { "cobblestone": 24, "clay": 12 },
                 desc: "A stone body on a scaffold, waiting for a heart."),
                (name: "golem_heart", title: "Golem Heart", tier: 2, gives: Upgrade, after: ["golem_frame"],
                 needs: { "spirit_ember": 8, "old_coin": 2, "mold_bloom": 3 },
                 desc: "The golem wakes and follows you."),
                (name: "golem_hands", title: "Working Hands", tier: 3, gives: Upgrade, after: ["golem_heart"],
                 needs: { "raw_iron": 12, "cordage": 6, "deepstone_shard": 4, "warden_sigil": 1 },
                 desc: "The golem carries a load for you and fights off creatures that come near."),
            ],
        ),
    ],
)
