// Snow cover and puddles (game::cover; water flow itself is in game::cover::flow).
// Every `every` seconds, `columns` random columns within `radius` blocks of you
// (loaded chunks, open to the sky) are looked at; each chance below is per look,
// so a column is looked at about every radius^2 * 3.14 / columns * every seconds.
(
    every: 2.0,
    columns: 256,
    radius: 48,
    // Snowfall at full strength adds a layer with this chance (times precipitation),
    // whenever it snows; plants and pebbles stay in the snow.
    snow: 1.0,
    // Above freezing a snow layer melts with this chance at about 10 °C, less when
    // only just above freezing (doubled in rain).
    melt: 0.5,
    // Rain at full strength adds a level of water to a low spot with this chance.
    rain: 0.8,
    // Once the rain stops, water short of a full block loses a level with this
    // chance per look, and puddles water has flowed into or rain has filled with
    // this chance per second.
    dry: 0.1,
)
