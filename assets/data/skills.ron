                (title: "Deep Well", cost: 1, gives: [Focus(25.0)]),
                (title: "Feather Soul", cost: 1, gives: [LevitateCost(0.2)]),
                (title: "Quiet Mind", cost: 1, gives: [FocusRegen(1.0)]),
                (title: "Hearthsong", cost: 2, gives: [Spell(Warmth)]),
                (title: "Wide Well", cost: 2, gives: [Focus(40.0)]),
                (title: "Drifting", cost: 2, gives: [LevitateCost(0.3)]),
