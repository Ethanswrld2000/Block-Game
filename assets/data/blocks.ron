// Block definitions. Order matters: a block's position in this list is its id.
// Never reorder or delete once worlds are saved (phase 3 adds saving); append new blocks.
//   name:        unique id used in code and data
//   top/bottom/side: tile names from textures/blocks.ron (omit bottom/side to reuse top)
//   solid:       collides and can be stood on
//   opaque:      hides the faces behind it (false for leaves, water, glass, plants)
//   translucent: drawn see-through, blended (water, ice); default false
[
    (name: "air", solid: false, opaque: false),
    (name: "stone", top: "stone"),
    (name: "dirt", top: "dirt"),
    (name: "grass", top: "grass_top", bottom: "dirt", side: "grass_side"),
    (name: "mud", top: "mud"),
    (name: "moss", top: "moss"),
    (name: "peat", top: "peat"),
    (name: "sand", top: "sand"),
    (name: "gravel", top: "gravel"),
    (name: "clay", top: "clay"),
    (name: "cobblestone", top: "cobblestone"),
    (name: "planks", top: "planks"),
    (name: "log", top: "log_top", side: "log_side"),
    (name: "leaves", top: "leaves", opaque: false),
    (name: "swamp_log", top: "swamp_log_top", side: "swamp_log_side"),
    (name: "swamp_leaves", top: "swamp_leaves", opaque: false),
    (name: "water", top: "water", solid: false, opaque: false, translucent: true),
    (name: "snow", top: "snow"),
    (name: "ice", top: "ice", opaque: false, translucent: true),
    (name: "coal_ore", top: "coal_ore"),
    (name: "iron_ore", top: "iron_ore"),
    (name: "skystone", top: "skystone"),
    (name: "cloud_moss", top: "cloud_moss"),
    (name: "deeprock", top: "deeprock"),
]
