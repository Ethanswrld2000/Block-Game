// Block definitions. Order matters: a block's position in this list is its id.
// Never reorder or delete once worlds are saved; append new blocks at the end.
//   name:        unique id used in code and data
//   top/bottom/side: tile names from textures/blocks.ron (omit bottom/side to reuse top)
//   solid:       collides and can be stood on
//   opaque:      hides the faces behind it (false for leaves, water, glass, plants)
//   translucent: drawn see-through, blended (water, ice); default false
//   foliage:     tinted by the season (seasons.ron); all faces of see-through blocks, top only otherwise
//   hardness:    seconds to break by hand at speed 1 (default 1); tools divide it (items.ron)
//   material:    what tools are rated against: stone, ore, wood, soil, plant (default "generic")
//   shape:       cube (default), torch (drawn as its own model with a light) or plant
//                (two crossed quads that sway in the wind; worldgen scatters them by
//                `plants` in biomes.ron, and they go when the block below them is mined)
[
    (name: "air", solid: false, opaque: false, hardness: 0.0),
    (name: "stone", top: "stone", hardness: 3.0, material: "stone"),
    (name: "dirt", top: "dirt", hardness: 0.8, material: "soil"),
    (name: "grass", top: "grass_top", bottom: "dirt", side: "grass_side", foliage: true, hardness: 0.9, material: "soil"),
    (name: "mud", top: "mud", hardness: 0.9, material: "soil"),
    (name: "moss", top: "moss", foliage: true, hardness: 0.7, material: "soil"),
    (name: "peat", top: "peat", hardness: 0.9, material: "soil"),
    (name: "sand", top: "sand", hardness: 0.7, material: "soil"),
    (name: "gravel", top: "gravel", hardness: 1.0, material: "soil"),
    (name: "clay", top: "clay", hardness: 1.0, material: "soil"),
    (name: "cobblestone", top: "cobblestone", hardness: 3.0, material: "stone"),
    (name: "planks", top: "planks", hardness: 2.0, material: "wood"),
    (name: "log", top: "log_top", side: "log_side", hardness: 2.5, material: "log"),
    (name: "leaves", top: "leaves", opaque: false, foliage: true, hardness: 0.3, material: "plant"),
    (name: "swamp_log", top: "swamp_log_top", side: "swamp_log_side", hardness: 2.5, material: "log"),
    (name: "swamp_leaves", top: "swamp_leaves", opaque: false, foliage: true, hardness: 0.3, material: "plant"),
    (name: "water", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0),
    (name: "snow", top: "snow", hardness: 0.5, material: "soil"),
    (name: "ice", top: "ice", opaque: false, translucent: true, hardness: 1.0, material: "stone"),
    (name: "coal_ore", top: "coal_ore", hardness: 4.0, material: "ore"),
    (name: "iron_ore", top: "iron_ore", hardness: 5.0, material: "ore"),
    (name: "skystone", top: "skystone", hardness: 3.0, material: "stone"),
    (name: "cloud_moss", top: "cloud_moss", hardness: 0.7, material: "soil"),
    (name: "deeprock", top: "deeprock", hardness: 7.0, material: "stone"),
    (name: "torch", top: "planks", solid: false, opaque: false, hardness: 0.0, shape: torch),
    // A storage chest: right click opens it (contents are kept in saves/<world>/chests.ron).
    (name: "chest", top: "log_top", bottom: "planks", side: "planks", hardness: 2.0, material: "wood"),
    // Ground plants: crossed quads that sway in the wind (see `plants` in biomes.ron).
    (name: "tall_grass", top: "tall_grass", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: plant),
    (name: "reeds", top: "reed", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "fern", top: "fern", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: plant),
    (name: "bog_bloom", top: "bog_bloom", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    // The floor of the world (y -300): can't be mined.
    (name: "rootstone", top: "rootstone", hardness: -1.0, material: "stone"),
    // Tree details (worldgen::trees): vines hang against a side, twigs poke out of trunks
    // (pull one off for a stick), pebbles lie on the ground (pick up for a small rock).
    // `attach` is the side of the cell they cling to.
    (name: "vine_north", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: vine, attach: north),
    (name: "vine_south", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: vine, attach: south),
    (name: "vine_east", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: vine, attach: east),
    (name: "vine_west", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: vine, attach: west),
    (name: "twig_north", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: north),
    (name: "twig_south", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: south),
    (name: "twig_east", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: east),
    (name: "twig_west", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: west),
    (name: "pebble", top: "cobblestone", solid: false, opaque: false, hardness: 0.0, material: "stone", shape: pebble),
    // Building supplies from the carpentry table (benches.ron).
    (name: "floorboards", top: "floorboards", hardness: 2.0, material: "wood"),
    (name: "timber_wall", top: "timber_wall", hardness: 2.5, material: "wood"),
    (name: "wattle_wall", top: "wattle_wall", hardness: 1.5, material: "wood"),
    (name: "thatch", top: "thatch", hardness: 0.8, material: "plant"),
    (name: "chair", top: "chair", hardness: 1.5, material: "wood"),
    (name: "table", top: "table", hardness: 2.0, material: "wood"),
    (name: "wooden_door", top: "wooden_door", hardness: 2.0, material: "wood"),
    (name: "glass", top: "glass", opaque: false, translucent: true, hardness: 0.5, material: "stone"),
    (name: "window", top: "window", opaque: false, translucent: true, hardness: 1.0, material: "wood"),
    // Sporrow's houses (worldgen::landmarks): giant mushrooms.
    (name: "mushroom_stem", top: "mushroom_stem", hardness: 1.2, material: "wood"),
    (name: "mushroom_cap", top: "mushroom_cap", bottom: "mushroom_gills", hardness: 0.8, material: "wood"),
    (name: "burnt_stem", top: "burnt_stem", hardness: 0.8, material: "wood"),
    (name: "burnt_cap", top: "burnt_cap", hardness: 0.6, material: "wood"),
    (name: "grave", top: "grave", hardness: 3.0, material: "stone"),
    // Biome round 2: fungal ground and mushrooms, shrubs and brush, redwoods.
    (name: "spore_soil", top: "spore_soil", bottom: "dirt", side: "spore_soil_side", hardness: 0.8, material: "soil"),
    (name: "shrub", top: "shrub", solid: false, opaque: false, foliage: true, hardness: 0.1, material: "plant", shape: plant),
    (name: "dry_brush", top: "dry_brush", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "brown_mushroom", top: "brown_mushroom", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "glowcap", top: "glowcap", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "redwood_log", top: "redwood_log_top", side: "redwood_log_side", hardness: 3.0, material: "log"),
    (name: "redwood_leaves", top: "redwood_leaves", opaque: false, foliage: true, hardness: 0.3, material: "plant"),
]
