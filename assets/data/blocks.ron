// Block definitions. Order matters: a block's position in this list is its id.
// Never reorder or delete once worlds are saved; append new blocks at the end.
//   name:        unique id used in code and data
//   top/bottom/side: tile names from textures/blocks.ron (omit bottom/side to reuse top)
//   solid:       collides and can be stood on
//   opaque:      hides the faces behind it (false for leaves, water, glass, plants)
//   translucent: drawn see-through, blended (water, ice); default false
//   foliage:     tinted by the season (seasons.ron); all faces of see-through blocks, top only otherwise
//   hardness:    seconds to break by hand at speed 1 (default 1); tools divide it (items.ron)
//   material:    what tools are rated against: stone, ore, wood, soil, plant (default "generic")
//   shape:       cube (default) or torch (drawn as its own model with a light)
[
    (name: "air", solid: false, opaque: false, hardness: 0.0),
    (name: "stone", top: "stone", hardness: 3.0, material: "stone"),
    (name: "dirt", top: "dirt", hardness: 0.8, material: "soil"),
    (name: "grass", top: "grass_top", bottom: "dirt", side: "grass_side", foliage: true, hardness: 0.9, material: "soil"),
    (name: "mud", top: "mud", hardness: 0.9, material: "soil"),
    (name: "moss", top: "moss", foliage: true, hardness: 0.7, material: "soil"),
    (name: "peat", top: "peat", hardness: 0.9, material: "soil"),
    (name: "sand", top: "sand", hardness: 0.7, material: "soil"),
    (name: "gravel", top: "gravel", hardness: 1.0, material: "soil"),
    (name: "clay", top: "clay", hardness: 1.0, material: "soil"),
    (name: "cobblestone", top: "cobblestone", hardness: 3.0, material: "stone"),
    (name: "planks", top: "planks", hardness: 2.0, material: "wood"),
    (name: "log", top: "log_top", side: "log_side", hardness: 2.5, material: "wood"),
    (name: "leaves", top: "leaves", opaque: false, foliage: true, hardness: 0.3, material: "plant"),
    (name: "swamp_log", top: "swamp_log_top", side: "swamp_log_side", hardness: 2.5, material: "wood"),
    (name: "swamp_leaves", top: "swamp_leaves", opaque: false, foliage: true, hardness: 0.3, material: "plant"),
    (name: "water", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0),
    (name: "snow", top: "snow", hardness: 0.5, material: "soil"),
    (name: "ice", top: "ice", opaque: false, translucent: true, hardness: 1.0, material: "stone"),
    (name: "coal_ore", top: "coal_ore", hardness: 4.0, material: "ore"),
    (name: "iron_ore", top: "iron_ore", hardness: 5.0, material: "ore"),
    (name: "skystone", top: "skystone", hardness: 3.0, material: "stone"),
    (name: "cloud_moss", top: "cloud_moss", hardness: 0.7, material: "soil"),
    (name: "deeprock", top: "deeprock", hardness: 7.0, material: "stone"),
    (name: "torch", top: "planks", solid: false, opaque: false, hardness: 0.0, shape: torch),
]
