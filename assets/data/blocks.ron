// Block definitions. Order matters: a block's position in this list is its id.
// Never reorder or delete once worlds are saved; append new blocks at the end.
//   name:        unique id used in code and data
//   top/bottom/side: tile names from textures/blocks.ron (omit bottom/side to reuse top)
//   solid:       collides and can be stood on
//   opaque:      hides the faces behind it (false for leaves, water, glass, plants)
//   translucent: drawn see-through, blended (water, ice); default false
//   foliage:     tinted by the season (seasons.ron); all faces of see-through blocks, top only otherwise
//   hardness:    seconds to break by hand at speed 1 (default 1); tools divide it (items.ron)
//   material:    what tools are rated against: stone, ore, wood, soil, plant (default "generic")
//   light:       block light it gives off, 0..15 (torch 14, campfire 15); lights the terrain around it
//   shape:       cube (default), torch (drawn as its own model with a light) or plant
//                (two crossed quads that sway in the wind; worldgen scatters them by
//                `plants` in biomes.ron, and they go when the block below them is mined)
//                or layer (a flat layer `level` eighths high on the block below: snow cover
//                and puddles, built up and worn away by the weather in game::cover)
//   tree:        trunk (logs, stems) or crown (leaves, caps): cut a trunk through and
//                everything it held up topples away from you (voxel::fell)
//   axis:        x, y (default) or z: the way a log's grain runs; its end tiles face along it.
//                Lying logs are named `<log>_x` / `<log>_z` (what falling trees turn into)
//   dig_to:      dug without a tool rated for its material (a shovel for soil), it doesn't go at once:
//                it becomes this lower layer of itself (dirt -> dirt_layer_6 -> 4 -> 2 -> gone)
//   slows:       walking speed while you stand in it, 0..1 (brush; default 1)
[
    (name: "air", solid: false, opaque: false, hardness: 0.0),
    (name: "stone", top: "stone", hardness: 4.5, material: "stone"),
    (name: "dirt", top: "dirt", hardness: 1.2, material: "soil", dig_to: "dirt_layer_6"),
    (name: "grass", top: "grass_top", bottom: "dirt", side: "grass_side", foliage: true, hardness: 1.35, material: "soil", dig_to: "dirt_layer_6"),
    (name: "mud", top: "mud", hardness: 1.35, material: "soil", dig_to: "mud_layer_6"),
    (name: "moss", top: "moss", foliage: true, hardness: 1.05, material: "soil", dig_to: "dirt_layer_6"),
    (name: "peat", top: "peat", hardness: 1.35, material: "soil", dig_to: "peat_layer_6"),
    (name: "sand", top: "sand", hardness: 1.05, material: "soil", dig_to: "sand_layer_6"),
    (name: "gravel", top: "gravel", hardness: 1.5, material: "soil", dig_to: "gravel_layer_6"),
    (name: "clay", top: "clay", hardness: 1.5, material: "soil", dig_to: "clay_layer_6"),
    (name: "cobblestone", top: "cobblestone", hardness: 4.5, material: "stone"),
    (name: "planks", top: "planks", hardness: 3.0, material: "wood"),
    (name: "log", top: "log_top", side: "log_side", hardness: 3.75, material: "log", tree: trunk),
    (name: "leaves", top: "leaves", opaque: false, foliage: true, hardness: 0.9, material: "plant", tree: crown),
    (name: "swamp_log", top: "swamp_log_top", side: "swamp_log_side", hardness: 3.75, material: "log", tree: trunk),
    (name: "swamp_leaves", top: "swamp_leaves", opaque: false, foliage: true, hardness: 0.9, material: "plant", tree: crown),
    (name: "water", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0),
    (name: "snow", top: "snow", hardness: 0.75, material: "soil", dig_to: "snow_layer_6"),
    (name: "ice", top: "ice", opaque: false, translucent: true, hardness: 1.5, material: "stone"),
    (name: "coal_ore", top: "coal_ore", hardness: 6.0, material: "ore"),
    (name: "iron_ore", top: "iron_ore", hardness: 7.5, material: "ore"),
    (name: "skystone", top: "skystone", hardness: 4.5, material: "stone"),
    (name: "cloud_moss", top: "cloud_moss", hardness: 1.05, material: "soil", dig_to: "dirt_layer_6"),
    (name: "deeprock", top: "deeprock", hardness: 10.5, material: "stone"),
    (name: "torch", top: "planks", solid: false, opaque: false, hardness: 0.0, shape: torch, light: 14),
    // A ring of stones round crossed sticks: a big fire that warms you far more than a torch (drawn by `torches`).
    (name: "campfire", top: "planks", solid: false, opaque: false, hardness: 0.5, material: "wood", shape: torch, light: 15),
    // A storage chest: right click opens it (contents are kept in saves/<world>/chests.ron).
    (name: "chest", top: "log_top", bottom: "planks", side: "planks", hardness: 3.0, material: "wood"),
    // Ground plants: crossed quads that sway in the wind (see `plants` in biomes.ron).
    (name: "tall_grass", top: "tall_grass", solid: false, opaque: false, foliage: true, hardness: 0.35, material: "plant", shape: plant, slows: 0.85),
    (name: "reeds", top: "reed", solid: false, opaque: false, hardness: 0.6, material: "plant", shape: plant, slows: 0.75),
    (name: "fern", top: "fern", solid: false, opaque: false, foliage: true, hardness: 0.6, material: "plant", shape: plant, slows: 0.8),
    (name: "bog_bloom", top: "bog_bloom", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    // Crops (crops.ron): each stage is its own plant block; `farming` swaps them as they grow.
    (name: "barley_0", top: "barley_0", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: plant),
    (name: "barley_1", top: "barley_1", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: plant),
    (name: "barley_2", top: "barley_2", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "tuber_0", top: "tuber_0", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: plant),
    (name: "tuber_1", top: "tuber_1", solid: false, opaque: false, foliage: true, hardness: 0.05, material: "plant", shape: plant),
    (name: "tuber_2", top: "tuber_2", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    // The floor of the world (y -300): can't be mined.
    (name: "rootstone", top: "rootstone", hardness: -1.0, material: "stone"),
    // Tree details (worldgen::trees): vines hang against a side, twigs poke out of trunks
    // (pull one off for a stick), pebbles lie on the ground (pick up for a small rock).
    // `attach` is the side of the cell they cling to.
    (name: "vine_north", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.35, material: "plant", shape: vine, attach: north),
    (name: "vine_south", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.35, material: "plant", shape: vine, attach: south),
    (name: "vine_east", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.35, material: "plant", shape: vine, attach: east),
    (name: "vine_west", top: "vine", solid: false, opaque: false, foliage: true, hardness: 0.35, material: "plant", shape: vine, attach: west),
    (name: "twig_north", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: north),
    (name: "twig_south", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: south),
    (name: "twig_east", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: east),
    (name: "twig_west", top: "log_side", solid: false, opaque: false, hardness: 0.0, material: "plant", shape: twig, attach: west),
    (name: "pebble", top: "cobblestone", solid: false, opaque: false, hardness: 0.0, material: "stone", shape: pebble),
    // Building supplies from the carpentry table (benches.ron).
    (name: "floorboards", top: "floorboards", hardness: 3.0, material: "wood"),
    (name: "timber_wall", top: "timber_wall", hardness: 3.75, material: "wood"),
    (name: "wattle_wall", top: "wattle_wall", hardness: 2.25, material: "wood"),
    (name: "thatch", top: "thatch", hardness: 1.2, material: "plant"),
    // Furniture: `shape: model` draws a few boxes (`chunk_mesh::model_boxes`); facing comes from walls beside it.
    // Right click a door to open or close it (with the door above or below it).
    (name: "chair", top: "planks", opaque: false, hardness: 2.25, material: "wood", shape: model, model: chair),
    (name: "table", top: "planks", opaque: false, hardness: 3.0, material: "wood", shape: model, model: table),
    (name: "wooden_door", top: "wooden_door", opaque: false, hardness: 3.0, material: "wood", shape: model, model: door),
    (name: "wooden_door_open", top: "wooden_door", solid: false, opaque: false, hardness: 3.0, material: "wood", shape: model, model: door_open),
    (name: "glass", top: "glass", opaque: false, translucent: true, hardness: 0.75, material: "stone"),
    (name: "window", top: "window", opaque: false, translucent: true, hardness: 1.5, material: "wood"),
    // Sporrow's houses (worldgen::landmarks): giant mushrooms.
    (name: "mushroom_stem", top: "mushroom_stem", hardness: 1.8, material: "wood", tree: trunk),
    (name: "mushroom_cap", top: "mushroom_cap", bottom: "mushroom_gills", hardness: 1.2, material: "wood", tree: crown),
    (name: "burnt_stem", top: "burnt_stem", hardness: 1.2, material: "wood", tree: trunk),
    (name: "burnt_cap", top: "burnt_cap", hardness: 0.9, material: "wood", tree: crown),
    (name: "grave", top: "grave", hardness: 4.5, material: "stone"),
    // On the biggest sky islands: right click once for a skill point (game::shrine). Can't be broken.
    (name: "sky_shrine", top: "sky_shrine_top", side: "sky_shrine", hardness: -1.0, material: "stone", light: 11),
    // Biome round 2: fungal ground and mushrooms, shrubs and brush, redwoods.
    (name: "spore_soil", top: "spore_soil", bottom: "dirt", side: "spore_soil_side", hardness: 1.2, material: "soil", dig_to: "dirt_layer_6"),
    (name: "shrub", top: "shrub", solid: false, opaque: false, foliage: true, hardness: 0.7, material: "plant", shape: plant, slows: 0.6),
    (name: "dry_brush", top: "dry_brush", solid: false, opaque: false, hardness: 0.7, material: "plant", shape: plant, slows: 0.65),
    (name: "brown_mushroom", top: "brown_mushroom", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "glowcap", top: "glowcap", solid: false, opaque: false, hardness: 0.05, material: "plant", shape: plant),
    (name: "redwood_log", top: "redwood_log_top", side: "redwood_log_side", hardness: 4.5, material: "log", tree: trunk),
    (name: "redwood_leaves", top: "redwood_leaves", opaque: false, foliage: true, hardness: 0.9, material: "plant", tree: crown),
    (name: "snow_layer_1", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 1, fills_around: true),
    (name: "snow_layer_2", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 2, fills_around: true),
    (name: "snow_layer_3", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 3, fills_around: true),
    (name: "snow_layer_4", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 4, fills_around: true),
    (name: "snow_layer_5", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 5, fills_around: true),
    (name: "snow_layer_6", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 6, fills_around: true),
    (name: "snow_layer_7", top: "snow", solid: false, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 7, fills_around: true),
    (name: "snow_layer_8", top: "snow", solid: true, opaque: false, hardness: 0.1, material: "soil", shape: layer, level: 8, fills_around: true),
    (name: "puddle_1", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 1),
    (name: "puddle_2", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 2),
    (name: "puddle_3", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 3),
    (name: "puddle_4", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 4),
    (name: "puddle_5", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 5),
    (name: "puddle_6", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 6),
    (name: "puddle_7", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 7),
    (name: "puddle_8", top: "water", solid: false, opaque: false, translucent: true, hardness: -1.0, shape: layer, level: 8),
    // Dug by hand: soil goes down a quarter at a time (`dig_to`); a shovel takes the whole block.
    (name: "dirt_layer_6", top: "dirt", solid: false, opaque: false, hardness: 1.2, material: "soil", shape: layer, level: 6, dig_to: "dirt_layer_4"),
    (name: "dirt_layer_4", top: "dirt", solid: false, opaque: false, hardness: 1.2, material: "soil", shape: layer, level: 4, dig_to: "dirt_layer_2"),
    (name: "dirt_layer_2", top: "dirt", solid: false, opaque: false, hardness: 1.2, material: "soil", shape: layer, level: 2),
    (name: "sand_layer_6", top: "sand", solid: false, opaque: false, hardness: 1.05, material: "soil", shape: layer, level: 6, dig_to: "sand_layer_4"),
    (name: "sand_layer_4", top: "sand", solid: false, opaque: false, hardness: 1.05, material: "soil", shape: layer, level: 4, dig_to: "sand_layer_2"),
    (name: "sand_layer_2", top: "sand", solid: false, opaque: false, hardness: 1.05, material: "soil", shape: layer, level: 2),
    (name: "mud_layer_6", top: "mud", solid: false, opaque: false, hardness: 1.35, material: "soil", shape: layer, level: 6, dig_to: "mud_layer_4"),
    (name: "mud_layer_4", top: "mud", solid: false, opaque: false, hardness: 1.35, material: "soil", shape: layer, level: 4, dig_to: "mud_layer_2"),
    (name: "mud_layer_2", top: "mud", solid: false, opaque: false, hardness: 1.35, material: "soil", shape: layer, level: 2),
    (name: "gravel_layer_6", top: "gravel", solid: false, opaque: false, hardness: 1.5, material: "soil", shape: layer, level: 6, dig_to: "gravel_layer_4"),
    (name: "gravel_layer_4", top: "gravel", solid: false, opaque: false, hardness: 1.5, material: "soil", shape: layer, level: 4, dig_to: "gravel_layer_2"),
    (name: "gravel_layer_2", top: "gravel", solid: false, opaque: false, hardness: 1.5, material: "soil", shape: layer, level: 2),
    (name: "clay_layer_6", top: "clay", solid: false, opaque: false, hardness: 1.5, material: "soil", shape: layer, level: 6, dig_to: "clay_layer_4"),
    (name: "clay_layer_4", top: "clay", solid: false, opaque: false, hardness: 1.5, material: "soil", shape: layer, level: 4, dig_to: "clay_layer_2"),
    (name: "clay_layer_2", top: "clay", solid: false, opaque: false, hardness: 1.5, material: "soil", shape: layer, level: 2),
    (name: "peat_layer_6", top: "peat", solid: false, opaque: false, hardness: 1.35, material: "soil", shape: layer, level: 6, dig_to: "peat_layer_4"),
    (name: "peat_layer_4", top: "peat", solid: false, opaque: false, hardness: 1.35, material: "soil", shape: layer, level: 4, dig_to: "peat_layer_2"),
    (name: "peat_layer_2", top: "peat", solid: false, opaque: false, hardness: 1.35, material: "soil", shape: layer, level: 2),
    // Logs lying on their side: what a felled trunk turns into (voxel::fell). Not `tree`:
    // they never fall again, and mining one just gives a log.
    (name: "log_x", top: "log_top", side: "log_side", hardness: 3.75, material: "log", axis: x),
    (name: "log_z", top: "log_top", side: "log_side", hardness: 3.75, material: "log", axis: z),
    (name: "swamp_log_x", top: "swamp_log_top", side: "swamp_log_side", hardness: 3.75, material: "log", axis: x),
    (name: "swamp_log_z", top: "swamp_log_top", side: "swamp_log_side", hardness: 3.75, material: "log", axis: z),
    (name: "redwood_log_x", top: "redwood_log_top", side: "redwood_log_side", hardness: 4.5, material: "log", axis: x),
    (name: "redwood_log_z", top: "redwood_log_top", side: "redwood_log_side", hardness: 4.5, material: "log", axis: z),
]
